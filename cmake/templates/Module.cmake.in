cmake_minimum_required(VERSION 3.28)
if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    project(@MODULE_NAME@ LANGUAGES CXX)
endif()
include("${CHERYL_ENGINE_SOURCE}/cmake/CherylModules.cmake")
option(CHERYL_BUILD_TESTS "Build module-local checks" OFF)
cheryl_prepare_module()

add_library(@MODULE_NAME@ STATIC src/module.cpp)
add_library(Cheryl::@MODULE_ALIAS@ ALIAS @MODULE_NAME@)
target_include_directories(@MODULE_NAME@ PUBLIC "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>")
target_link_libraries(@MODULE_NAME@ PUBLIC Cheryl::Engine)
if(CHERYL_BUILD_TESTS)
    add_subdirectory(tests)
endif()
