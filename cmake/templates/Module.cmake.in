cmake_minimum_required(VERSION 3.28)
include("${CHERYL_ENGINE_SOURCE}/cmake/CherylModules.cmake")
if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    project(@MODULE_NAME@ VERSION ${VERSION_PROJECT_MODULE_@MODULE_ID@} LANGUAGES CXX)
endif()
option(CHERYL_BUILD_TESTS "Build module-local checks" OFF)
cheryl_prepare_module()

file(GLOB_RECURSE module_sources CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp")
add_library(${TARGET_LIB_MODULE_@MODULE_ID@} STATIC ${module_sources})
add_library(Cheryl::@MODULE_ALIAS@ ALIAS ${TARGET_LIB_MODULE_@MODULE_ID@})
set_target_properties(${TARGET_LIB_MODULE_@MODULE_ID@} PROPERTIES
    VERSION "${VERSION_PROJECT_MODULE_@MODULE_ID@}"
    OUTPUT_NAME "${OUTPUT_LIB_MODULE_@MODULE_ID@}"
    ARCHIVE_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}")
target_include_directories(${TARGET_LIB_MODULE_@MODULE_ID@} PUBLIC "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>")
target_link_libraries(${TARGET_LIB_MODULE_@MODULE_ID@} PUBLIC ${LINKAGE_PUBLIC_LIB_MODULE_@MODULE_ID@})
if(CHERYL_BUILD_TESTS)
    add_subdirectory(tests)
endif()
