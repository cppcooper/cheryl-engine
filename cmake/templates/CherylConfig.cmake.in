@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/CherylNativeTargets.cmake")

set(Cheryl_RUNTIME_DIRECTORIES)
if("@sdk_linkage@" STREQUAL "shared" OR @sdk_runtime_present@)
    if(WIN32)
        list(APPEND Cheryl_RUNTIME_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
    else()
        list(APPEND Cheryl_RUNTIME_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
    endif()
endif()

find_dependency(Threads)
if("@sdk_linkage@" STREQUAL "static")
    # Private third-party shared-library imports are installed with the SDK.
    # Only platform graphics/input APIs remain consumer-side discoveries.
    if(NOT WIN32)
        if("@sdk_native_udev@")
            find_dependency(PkgConfig)
            pkg_check_modules(CHERYL_NATIVE_UDEV REQUIRED IMPORTED_TARGET libudev)
        endif()
    endif()
    if(@sdk_opengl@)
        find_dependency(OpenGL)
    endif()
    if(@sdk_native_glfw@ AND UNIX AND NOT APPLE)
        find_dependency(X11)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CherylTargets.cmake")
foreach(pair IN ITEMS @sdk_public_native_aliases@)
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 alias)
    list(GET fields 1 implementation)
    if(TARGET "${implementation}" AND NOT TARGET "${alias}")
        add_library("${alias}" ALIAS "${implementation}")
    endif()
endforeach()
if(TARGET Cheryl::Workers)
    if(@sdk_hwloc@ AND NOT TARGET Cheryl::WorkerTopology::Hwloc)
        add_library(Cheryl::WorkerTopology::Hwloc INTERFACE IMPORTED)
        set_target_properties(Cheryl::WorkerTopology::Hwloc PROPERTIES INTERFACE_LINK_LIBRARIES Cheryl::Workers)
    endif()
    if(@sdk_json@ AND NOT TARGET Cheryl::WorkerTopology::Json)
        add_library(Cheryl::WorkerTopology::Json INTERFACE IMPORTED)
        set_target_properties(Cheryl::WorkerTopology::Json PROPERTIES INTERFACE_LINK_LIBRARIES Cheryl::Workers)
    endif()
endif()
check_required_components(Cheryl)
