@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

# Windows native dependencies are packaged in their own relocatable prefix.
set(cheryl_sdk_prefix_path "${CMAKE_PREFIX_PATH}")
set(cheryl_sdk_root "${PACKAGE_PREFIX_DIR}")
set(Cheryl_RUNTIME_DIRECTORIES)
if("@sdk_linkage@" STREQUAL "shared")
    if(WIN32)
        list(APPEND Cheryl_RUNTIME_DIRECTORIES "${cheryl_sdk_root}/@CMAKE_INSTALL_BINDIR@")
    elseif(UNIX)
        list(APPEND Cheryl_RUNTIME_DIRECTORIES "${cheryl_sdk_root}/@CMAKE_INSTALL_LIBDIR@")
    endif()
endif()
if(EXISTS "${cheryl_sdk_root}/dependencies")
    list(PREPEND CMAKE_PREFIX_PATH "${cheryl_sdk_root}/dependencies")
    list(APPEND Cheryl_RUNTIME_DIRECTORIES "${cheryl_sdk_root}/dependencies/bin")
endif()
find_dependency(Threads)
# HarfBuzz may import the FreeType config, so prefer its complete export set.
find_package(Freetype CONFIG QUIET)
if(NOT TARGET Freetype::Freetype)
    find_dependency(Freetype)
endif()
find_package(harfbuzz CONFIG QUIET)
if(NOT TARGET harfbuzz::harfbuzz)
    find_dependency(PkgConfig)
    pkg_check_modules(CHERYL_HARFBUZZ REQUIRED IMPORTED_TARGET harfbuzz)
    add_library(harfbuzz::harfbuzz ALIAS PkgConfig::CHERYL_HARFBUZZ)
elseif(NOT TARGET PkgConfig::CHERYL_HARFBUZZ)
    add_library(PkgConfig::CHERYL_HARFBUZZ INTERFACE IMPORTED)
    set_target_properties(PkgConfig::CHERYL_HARFBUZZ PROPERTIES INTERFACE_LINK_LIBRARIES harfbuzz::harfbuzz)
endif()
find_dependency(ICU COMPONENTS uc i18n)
string(REGEX MATCH "^[0-9]+" cheryl_sdk_icu_major "@ICU_VERSION@")
string(REGEX MATCH "^[0-9]+" cheryl_host_icu_major "${ICU_VERSION}")
if(NOT cheryl_sdk_icu_major STREQUAL cheryl_host_icu_major)
    set(Cheryl_FOUND FALSE)
    set(Cheryl_NOT_FOUND_MESSAGE "This SDK requires ICU ${cheryl_sdk_icu_major}.x; found ${ICU_VERSION}")
    return()
endif()
if(@CHERYL_BUILD_OPENGL@)
    find_dependency(OpenGL)
endif()
if(@CHERYL_BUILD_NATIVE_GLFW@ AND UNIX AND NOT APPLE)
    find_dependency(X11)
endif()
if(@CHERYL_BUILD_WORKER_TOPOLOGY_HWLOC@ AND NOT TARGET CherylSdk::Hwloc)
    find_path(cheryl_sdk_hwloc_include hwloc.h REQUIRED)
    find_library(cheryl_sdk_hwloc_library NAMES hwloc libhwloc REQUIRED)
    file(STRINGS "${cheryl_sdk_hwloc_include}/hwloc.h" cheryl_sdk_hwloc_api_line
        REGEX "^#define[ \t]+HWLOC_API_VERSION[ \t]+")
    string(REGEX MATCH "0x[0-9a-fA-F]+" cheryl_sdk_hwloc_api "${cheryl_sdk_hwloc_api_line}")
    if(NOT cheryl_sdk_hwloc_api)
        set(Cheryl_FOUND FALSE)
        set(Cheryl_NOT_FOUND_MESSAGE "Cannot identify the installed hwloc API")
        return()
    endif()
    math(EXPR cheryl_sdk_hwloc_api "${cheryl_sdk_hwloc_api}")
    if(cheryl_sdk_hwloc_api LESS 0x00020500 OR cheryl_sdk_hwloc_api GREATER_EQUAL 0x00030000)
        set(Cheryl_FOUND FALSE)
        set(Cheryl_NOT_FOUND_MESSAGE "This SDK requires the hwloc 2.5+ (2.x) API")
        return()
    endif()
    add_library(CherylSdk::Hwloc UNKNOWN IMPORTED)
    set_target_properties(CherylSdk::Hwloc PROPERTIES
        IMPORTED_LOCATION "${cheryl_sdk_hwloc_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${cheryl_sdk_hwloc_include}")
endif()
if(@sdk_hidapi_external@)
    find_dependency(hidapi CONFIG)
endif()
if(@sdk_hidapi_libudev@ OR @sdk_hidapi_libusb@)
    find_dependency(PkgConfig)
    if(@sdk_hidapi_libudev@ AND NOT TARGET PkgConfig::libudev)
        pkg_check_modules(libudev REQUIRED IMPORTED_TARGET libudev)
    endif()
    if(@sdk_hidapi_libusb@ AND NOT TARGET PkgConfig::libusb)
        pkg_check_modules(libusb REQUIRED IMPORTED_TARGET libusb-1.0>=1.0.9)
    endif()
endif()
if(@sdk_hidapi_iconv@)
    find_dependency(Iconv)
endif()
set(CMAKE_PREFIX_PATH "${cheryl_sdk_prefix_path}")
include("${CMAKE_CURRENT_LIST_DIR}/CherylTargets.cmake")
check_required_components(Cheryl)
