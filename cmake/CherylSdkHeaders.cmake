include_guard(GLOBAL)

function(cheryl_sdk_header_roots target namespace result)
    set(visited ${ARGN})
    if(target IN_LIST visited)
        set(${result} "" PARENT_SCOPE)
        return()
    endif()
    list(APPEND visited "${target}")
    set(roots)
    foreach(property IN ITEMS INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
        get_target_property(includes "${target}" "${property}")
        foreach(directory IN LISTS includes)
            while(directory MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                set(directory "${CMAKE_MATCH_1}")
            endwhile()
            if(NOT directory MATCHES "\\$<" AND IS_DIRECTORY "${directory}/${namespace}")
                list(APPEND roots "${directory}")
            endif()
        endforeach()
    endforeach()
    get_target_property(links "${target}" INTERFACE_LINK_LIBRARIES)
    foreach(link IN LISTS links)
        if(TARGET "${link}")
            cheryl_sdk_header_roots("${link}" "${namespace}" child_roots ${visited})
            list(APPEND roots ${child_roots})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES roots)
    set(${result} "${roots}" PARENT_SCOPE)
endfunction()

function(cheryl_sdk_native_headers target namespace)
    cheryl_sdk_header_roots("${target}" "${namespace}" roots)
    foreach(header IN LISTS ARGN)
        set(found OFF)
        foreach(root IN LISTS roots)
            if(EXISTS "${root}/${namespace}/${header}")
                set(found ON)
                break()
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "SDK packaging cannot find ${namespace}/${header} in ${target}'s public include directories; supply the headers matching this native runtime")
        endif()
    endforeach()
    # Select each path once so generated headers in earlier public include
    # directories take precedence regardless of source file timestamps.
    set(selected)
    foreach(root IN LISTS roots)
        file(GLOB_RECURSE headers RELATIVE "${root}/${namespace}" LIST_DIRECTORIES FALSE
            "${root}/${namespace}/*.h" "${root}/${namespace}/*.hpp" "${root}/${namespace}/*.inl"
            "${root}/${namespace}/*.ipp" "${root}/${namespace}/*.tpp")
        foreach(header IN LISTS headers)
            if(header IN_LIST selected)
                continue()
            endif()
            list(APPEND selected "${header}")
            get_filename_component(directory "${header}" DIRECTORY)
            install(FILES "${root}/${namespace}/${header}"
                DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/${namespace}/${directory}" COMPONENT CherylSDK)
        endforeach()
    endforeach()
endfunction()
