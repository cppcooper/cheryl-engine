include_guard(GLOBAL)

function(cheryl_runtime_dependency_location result name)
    set(locations ${ARGN})
    list(GET locations 0 selected)
    file(SHA256 "${selected}" selected_hash)
    foreach(location IN LISTS locations)
        file(SHA256 "${location}" location_hash)
        if(NOT location_hash STREQUAL selected_hash)
            message(FATAL_ERROR "Native DLL dependencies have conflicting locations: ${name}: ${locations}")
        endif()
    endforeach()
    set(${result} "${selected}" PARENT_SCOPE)
endfunction()

# Resolve the deployment closure while leaving operating-system interfaces and
# the compiler runtime as platform prerequisites.
function(cheryl_runtime_dependencies result)
    cmake_policy(PUSH)
    if(POLICY CMP0207)
        cmake_policy(SET CMP0207 NEW)
    endif()
    set(libraries ${ARGN})
    list(REMOVE_DUPLICATES libraries)
    set(directories)
    foreach(library IN LISTS libraries)
        get_filename_component(directory "${library}" DIRECTORY)
        list(APPEND directories "${directory}")
    endforeach()
    list(REMOVE_DUPLICATES directories)
    if(NOT libraries)
        set(${result} "" PARENT_SCOPE)
        cmake_policy(POP)
        return()
    endif()
    set(system_paths)
    if(WIN32)
        set(system_patterns "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
            "^[Ii][Cc][Uu]\\.[Dd][Ll][Ll]$" "^[Oo][Pp][Ee][Nn][Gg][Ll]32\\.[Dd][Ll][Ll]$"
            "^[Vv][Cc][Rr][Uu][Nn][Tt][Ii][Mm][Ee]" "^[Mm][Ss][Vv][Cc][PpRr]"
            "^[Cc][Oo][Nn][Cc][Rr][Tt]" "^[Uu][Cc][Rr][Tt][Bb][Aa][Ss][Ee]")
        file(TO_CMAKE_PATH "$ENV{SystemRoot}" system_root)
        if(system_root)
            string(TOLOWER "${system_root}" system_pattern)
            string(REGEX REPLACE "/+$" "" system_pattern "${system_pattern}")
            string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" system_pattern "${system_pattern}")
            string(REGEX MATCHALL "[a-z]" system_letters "${system_pattern}")
            list(REMOVE_DUPLICATES system_letters)
            foreach(letter IN LISTS system_letters)
                string(TOUPPER "${letter}" upper)
                string(REPLACE "${letter}" "[${letter}${upper}]" system_pattern "${system_pattern}")
            endforeach()
            list(APPEND system_paths "^${system_pattern}/")
        endif()
    else()
        set(system_patterns "^(ld-linux|ld64|ld-musl)"
            "^lib(c|m|mvec|dl|pthread|rt|resolv|util|anl|BrokenLocale|nss_[A-Za-z0-9_]+|stdc\\+\\+|gcc_s)\\.so(\\.|$)"
            "^lib(GL|GLX|EGL|OpenGL|GLdispatch|GLESv[0-9]+|X[A-Za-z0-9_]*|xcb[^/]*|wayland[^/]*|xkbcommon[^/]*|decor[^/]*|drm[^/]*|gbm)\\.so(\\.|$)"
            "^lib(asound|pulse[^/]*|jack[^/]*|udev)\\.so(\\.|$)")
    endif()
    file(GET_RUNTIME_DEPENDENCIES LIBRARIES ${libraries} DIRECTORIES ${directories}
        RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
        PRE_EXCLUDE_REGEXES ${system_patterns}
        # Filtering the finished list still follows private Windows imports.
        POST_EXCLUDE_REGEXES ${system_paths}
        CONFLICTING_DEPENDENCIES_PREFIX conflicts)
    # Source builds can resolve the same DLL beside Engine and in its original
    # dependency prefix. Copies are compatible only when their bytes match.
    foreach(name IN LISTS conflicts_FILENAMES)
        cheryl_runtime_dependency_location(location "${name}" ${conflicts_${name}})
        list(APPEND resolved "${location}")
    endforeach()
    if(unresolved)
        message(FATAL_ERROR "Cannot resolve required native runtime dependencies: ${unresolved}")
    endif()
    list(APPEND libraries ${resolved})
    list(REMOVE_DUPLICATES libraries)
    set(${result} "${libraries}" PARENT_SCOPE)
    cmake_policy(POP)
endfunction()

# Generated install scripts do not inherit the project's policy version.
# Functions capture policies at definition, including IN_LIST support.
cmake_policy(PUSH)
cmake_policy(SET CMP0057 NEW)
function(cheryl_sdk_install_runtimes destination)
    cheryl_runtime_dependencies(libraries ${ARGN})
    if(NOT libraries)
        return()
    endif()
    if(WIN32)
        file(INSTALL DESTINATION "${destination}" TYPE FILE FILES ${libraries})
        return()
    endif()
    find_program(CHERYL_PATCHELF_EXECUTABLE NAMES patchelf REQUIRED)
    foreach(library IN LISTS libraries)
        file(INSTALL DESTINATION "${destination}" TYPE SHARED_LIBRARY FOLLOW_SYMLINK_CHAIN FILES "${library}")
    endforeach()
    # An imported target may name its versioned real file directly. Its SONAME
    # alias then appears in neither the source symlink chain nor its own closure.
    # Validate aliases before patching changes the copied files' contents.
    foreach(library IN LISTS libraries)
        execute_process(COMMAND "${CHERYL_PATCHELF_EXECUTABLE}" --print-soname "${library}"
            RESULT_VARIABLE status OUTPUT_VARIABLE soname ERROR_VARIABLE diagnostic
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Cannot read the SDK runtime SONAME for ${library}: ${diagnostic}")
        endif()
        if(NOT soname)
            continue()
        endif()
        if(NOT soname MATCHES "^[A-Za-z0-9_+.-]+$" OR soname STREQUAL "." OR soname STREQUAL "..")
            message(FATAL_ERROR "Unsafe SDK runtime SONAME: ${soname}")
        endif()
        file(REAL_PATH "${library}" original_library)
        get_filename_component(name "${original_library}" NAME)
        set(installed_library "$ENV{DESTDIR}${destination}/${name}")
        set(alias "$ENV{DESTDIR}${destination}/${soname}")
        if(EXISTS "${alias}" OR IS_SYMLINK "${alias}")
            if(NOT EXISTS "${alias}")
                message(FATAL_ERROR "Broken SDK runtime SONAME alias: ${soname}")
            endif()
            file(SHA256 "${alias}" alias_hash)
            file(SHA256 "${installed_library}" library_hash)
            if(NOT alias_hash STREQUAL library_hash)
                message(FATAL_ERROR "Conflicting SDK runtime SONAME: ${soname}")
            endif()
        else()
            file(CREATE_LINK "${name}" "${alias}" SYMBOLIC RESULT status)
            if(NOT status STREQUAL "0")
                message(FATAL_ERROR "Cannot create SDK runtime SONAME alias ${soname}: ${status}")
            endif()
        endif()
    endforeach()
    # RUNPATH applies only to direct imports. Every native library therefore
    # needs its own relative search path for a relocated SDK's transitive imports.
    file(GLOB installed_libraries "$ENV{DESTDIR}${destination}/*.so" "$ENV{DESTDIR}${destination}/*.so.*")
    set(patched)
    foreach(library IN LISTS installed_libraries)
        file(REAL_PATH "${library}" real_library)
        if(real_library IN_LIST patched)
            continue()
        endif()
        list(APPEND patched "${real_library}")
        execute_process(COMMAND "${CHERYL_PATCHELF_EXECUTABLE}" --set-rpath "$ORIGIN" "${real_library}"
            RESULT_VARIABLE status ERROR_VARIABLE diagnostic)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Cannot set the SDK runtime search path for ${library}: ${diagnostic}")
        endif()
    endforeach()
    find_program(CHERYL_NOTICE_PYTHON NAMES python3 REQUIRED)
    set(notice_arguments --destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/share/licenses/native")
    if(CHERYL_SDK_NATIVE_PREFIX)
        list(APPEND notice_arguments --native-prefix "${CHERYL_SDK_NATIVE_PREFIX}")
    endif()
    execute_process(COMMAND "${CHERYL_NOTICE_PYTHON}"
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.github/ci/native_notices.py" ${notice_arguments} ${libraries}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot collect SDK redistribution notices: ${output}${diagnostic}")
    endif()
endfunction()
cmake_policy(POP)
