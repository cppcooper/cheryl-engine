# Discover only neutral engine dependencies; reuse targets from an enclosing build.
if(NOT TARGET Threads::Threads)
    find_package(Threads REQUIRED)
endif()
if(NOT TARGET Freetype::Freetype)
    find_package(Freetype CONFIG QUIET)
    if(NOT TARGET Freetype::Freetype)
        find_package(Freetype REQUIRED)
    endif()
endif()
if(NOT TARGET harfbuzz::harfbuzz)
    if(TARGET harfbuzz)
        add_library(harfbuzz::harfbuzz ALIAS harfbuzz)
    else()
        find_package(harfbuzz CONFIG QUIET)
        if(NOT TARGET harfbuzz::harfbuzz)
            find_package(PkgConfig REQUIRED)
            pkg_check_modules(CHERYL_HARFBUZZ REQUIRED IMPORTED_TARGET harfbuzz)
            add_library(harfbuzz::harfbuzz ALIAS PkgConfig::CHERYL_HARFBUZZ)
        endif()
    endif()
endif()
if(NOT TARGET Cheryl::ICU)
    add_library(cheryl_icu INTERFACE)
    add_library(Cheryl::ICU ALIAS cheryl_icu)
    if(WIN32)
        # Windows 10 1903+ supplies the complete C API used by text layout.
        target_link_libraries(cheryl_icu INTERFACE icu)
        set_property(TARGET cheryl_icu PROPERTY CHERYL_SHARED_DEPENDENCY_SYSTEM TRUE)
        set(ICU_VERSION "system")
    else()
        if(NOT TARGET ICU::uc OR NOT TARGET ICU::i18n OR NOT TARGET ICU::data)
            find_package(ICU REQUIRED COMPONENTS uc i18n data)
        endif()
        target_link_libraries(cheryl_icu INTERFACE ICU::uc ICU::i18n ICU::data)
    endif()
endif()
if(CHERYL_BUILD_TESTS AND NOT TARGET gtest)
    add_subdirectory("${CHERYL_REPOSITORY_ROOT}/extern/googletest" extern/googletest EXCLUDE_FROM_ALL)
    set_property(TARGET gtest PROPERTY CHERYL_OWNED_TEST_DEPENDENCY TRUE)
endif()
if(NOT TARGET ctti)
    add_subdirectory("${CHERYL_REPOSITORY_ROOT}/extern/ctti" extern/ctti EXCLUDE_FROM_ALL)
endif()
if(NOT TARGET Backward::Interface)
    set(BACKWARD_SHARED OFF)
    add_subdirectory("${CHERYL_REPOSITORY_ROOT}/extern/backward-cpp" extern/backward-cpp EXCLUDE_FROM_ALL)
endif()
if(NOT TARGET spdlog::spdlog)
    block(SCOPE_FOR VARIABLES)
        set(SPDLOG_USE_STD_FORMAT ON)
        set(BUILD_SHARED_LIBS OFF)
        set(SPDLOG_BUILD_SHARED OFF)
        add_subdirectory("${CHERYL_REPOSITORY_ROOT}/extern/spdlog" extern/spdlog EXCLUDE_FROM_ALL)
    endblock()
    set_property(TARGET spdlog PROPERTY CHERYL_OWNED_DEPENDENCY TRUE)
endif()
if(NOT TARGET glm::glm-header-only)
    set(GLM_ENABLE_EXPERIMENTAL ON)
    add_subdirectory("${CHERYL_REPOSITORY_ROOT}/extern/glm" extern/glm EXCLUDE_FROM_ALL)
endif()
