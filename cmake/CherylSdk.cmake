# SDK exports describe Cheryl-owned builds of the pinned dependencies. Keep
# ordinary build-tree composition and supplied dependency targets unchanged.
function(cheryl_sdk_target target exported_name)
    get_target_property(aliased ${target} ALIASED_TARGET)
    if(aliased)
        set(target "${aliased}")
    endif()
    get_target_property(imported ${target} IMPORTED)
    if(imported)
        message(FATAL_ERROR "The SDK requires the owned dependency target ${target}")
    endif()
    set_target_properties(${target} PROPERTIES EXPORT_NAME "${exported_name}")
    get_target_property(target_type ${target} TYPE)
    if(MSVC AND NOT target_type STREQUAL "INTERFACE_LIBRARY")
        set_target_properties(${target} PROPERTIES COMPILE_PDB_NAME "${target}"
            COMPILE_PDB_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}/sdk-symbols")
        install(FILES "${CHERYL_BUILD_ROOT}/sdk-symbols/${target}.pdb"
            DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK OPTIONAL)
    endif()
    get_target_property(includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
    set(build_includes)
    if(includes)
        foreach(path IN LISTS includes)
            list(APPEND build_includes "$<BUILD_INTERFACE:${path}>")
        endforeach()
    endif()
    set_property(TARGET ${target} PROPERTY INTERFACE_INCLUDE_DIRECTORIES
        "${build_includes};$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
    get_target_property(system_includes ${target} INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    if(system_includes)
        set(build_system_includes)
        foreach(path IN LISTS system_includes)
            list(APPEND build_system_includes "$<BUILD_INTERFACE:${path}>")
        endforeach()
        set_property(TARGET ${target} PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${build_system_includes}")
    endif()
    if(exported_name MATCHES "^(Engine|Startup|NativeGLFW|OpenGL|UI::|Audio::|WorkerTopology::)")
        target_include_directories(${target} INTERFACE "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/cheryl>")
    endif()
    if(exported_name STREQUAL "Engine")
        target_include_directories(${target} INTERFACE "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/glm>")
    endif()
    get_target_property(links ${target} INTERFACE_LINK_LIBRARIES)
    if(links)
        set(installed_links "${links}")
        if(VCPKG_INSTALLED_DIR)
            string(REPLACE "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}"
                "$<INSTALL_PREFIX>/dependencies" installed_links "${installed_links}")
        endif()
        if(target STREQUAL "${TARGET_LIB_ENGINE_S_WORKER_TOPOLOGY_HWLOC}")
            set(installed_links "Cheryl::Engine;$<LINK_ONLY:CherylSdk::Hwloc>")
        endif()
        string(REPLACE "$<TARGET_OBJECTS:${TARGET_LIB_ENGINE_S_SIGNAL_HANDLERS}>"
            "$<TARGET_OBJECTS:Cheryl::SignalHandlers>" installed_links "${installed_links}")
        set_property(TARGET ${target} PROPERTY INTERFACE_LINK_LIBRARIES
            "$<BUILD_INTERFACE:${links}>;$<INSTALL_INTERFACE:${installed_links}>")
    endif()
    set(public_headers)
    if(target STREQUAL "spdlog")
        get_target_property(header_files ${target} PUBLIC_HEADER)
        get_target_property(target_source ${target} SOURCE_DIR)
        set(absolute_headers)
        foreach(header IN LISTS header_files)
            if(IS_ABSOLUTE "${header}")
                list(APPEND absolute_headers "${header}")
            else()
                list(APPEND absolute_headers "${target_source}/${header}")
            endif()
        endforeach()
        set_property(TARGET ${target} PROPERTY PUBLIC_HEADER "${absolute_headers}")
        set(public_headers PUBLIC_HEADER DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/spdlog COMPONENT CherylSDK)
    endif()
    install(TARGETS ${target} EXPORT CherylSdkTargets ${public_headers}
        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK
        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK
        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT CherylSDK
        OBJECTS DESTINATION ${CMAKE_INSTALL_LIBDIR}/objects COMPONENT CherylSDK)
    set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_TARGETS ${target})
endfunction()

function(cheryl_sdk_headers directory)
    install(DIRECTORY "${directory}/" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
        COMPONENT CherylSDK FILES_MATCHING
        PATTERN "*.h" PATTERN "*.hpp" PATTERN "*.inl" PATTERN "*.ipp" PATTERN "*.tpp")
endfunction()

cheryl_sdk_target(${TARGET_LIB_ENGINE} Engine)
cheryl_sdk_target(${TARGET_LIB_ENGINE_S_LOGGING_CONFIG} LoggingConfig)
get_target_property(logging_definitions ${TARGET_LIB_ENGINE_S_LOGGING_CONFIG} INTERFACE_COMPILE_DEFINITIONS)
if(CHERYL_LOG_PROFILE STREQUAL "auto")
    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(sdk_log_profile 0)
    elseif(CMAKE_BUILD_TYPE STREQUAL "RelWithDebInfo")
        set(sdk_log_profile 1)
    else()
        set(sdk_log_profile 2)
    endif()
elseif(CHERYL_LOG_PROFILE STREQUAL "developer")
    set(sdk_log_profile 0)
elseif(CHERYL_LOG_PROFILE STREQUAL "support")
    set(sdk_log_profile 1)
else()
    set(sdk_log_profile 2)
endif()
set(sdk_log_definitions "CHERYL_LOG_PROFILE=${sdk_log_profile}")
if(NOT CHERYL_LOG_COMPILED_MASK STREQUAL "")
    list(APPEND sdk_log_definitions "CHERYL_LOG_COMPILED_MASK=${CHERYL_LOG_COMPILED_MASK}")
endif()
set_property(TARGET ${TARGET_LIB_ENGINE_S_LOGGING_CONFIG} PROPERTY INTERFACE_COMPILE_DEFINITIONS
    "$<BUILD_INTERFACE:${logging_definitions}>;$<INSTALL_INTERFACE:${sdk_log_definitions}>")
cheryl_sdk_target(${TARGET_LIB_ENGINE_S_SIGNAL_HANDLERS} SignalHandlers)
cheryl_sdk_target(${TARGET_LIB_ENGINE_S_STARTUP} Startup)
