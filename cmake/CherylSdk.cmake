function(cheryl_sdk_dependency_name target result)
    set(visited ${ARGN})
    if(target IN_LIST visited)
        set(${result} "" PARENT_SCOPE)
        return()
    endif()
    list(APPEND visited "${target}")
    get_target_property(concrete "${target}" ALIASED_TARGET)
    if(NOT concrete)
        set(concrete "${target}")
    endif()
    get_target_property(name "${concrete}" CHERYL_SDK_DEPENDENCY_NAME)
    if(NOT name)
        get_target_property(name "${concrete}" EXPORT_NAME)
    endif()
    if(NOT name)
        get_target_property(kind "${concrete}" TYPE)
        if(kind STREQUAL "INTERFACE_LIBRARY")
            get_target_property(links "${concrete}" INTERFACE_LINK_LIBRARIES)
            foreach(link IN LISTS links)
                if(TARGET "${link}")
                    cheryl_sdk_dependency_name("${link}" name ${visited})
                elseif(IS_ABSOLUTE "${link}")
                    get_property(dependencies GLOBAL PROPERTY CHERYL_SHARED_DEPENDENCIES)
                    foreach(entry IN LISTS dependencies)
                        string(REPLACE "|" ";" fields "${entry}")
                        list(GET fields 0 dependency)
                        get_target_property(location "${dependency}" IMPORTED_LOCATION)
                        if(location STREQUAL link)
                            cheryl_sdk_dependency_name("${dependency}" name ${visited})
                            break()
                        endif()
                    endforeach()
                endif()
                if(name)
                    break()
                endif()
            endforeach()
        endif()
    endif()
    set(${result} "${name}" PARENT_SCOPE)
endfunction()
