foreach(module IN ITEMS STARTUP WORKERS NATIVE_GLFW OPENGL UI_TGUI UI_RMLUI AUDIO_MINIAUDIO)
    if(TARGET "${TARGET_LIB_MODULE_${module}}")
        string(TOLOWER "${module}" component)
        string(APPEND sdk_component_versions ", \"${component}\": \"${VERSION_PROJECT_MODULE_${module}}\"")
    endif()
endforeach()
set(sdk_dependency_ownership "")
foreach(entry IN LISTS sdk_private_dependencies)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 dependency)
    list(GET fields 1 owner)
    if(sdk_dependency_ownership)
        string(APPEND sdk_dependency_ownership ",")
    endif()
    string(APPEND sdk_dependency_ownership
        "{\"dependency\":\"${dependency}\",\"owner\":\"${owner}\",\"archive\":\"$<TARGET_FILE_NAME:${dependency}>\",\"owner_artifact\":\"$<TARGET_FILE_NAME:${owner}>\"}")
endforeach()
set(sdk_engine_directory "${CMAKE_INSTALL_LIBDIR}")
set(sdk_engine_import_library "")
if(CHERYL_BUILD_SHARED_LIBS AND WIN32)
    set(sdk_engine_directory "${CMAKE_INSTALL_BINDIR}")
    set(sdk_engine_import_library "${CMAKE_INSTALL_LIBDIR}/$<TARGET_LINKER_FILE_NAME:${TARGET_LIB_ENGINE}>")
endif()
set(sdk_engine_library "${sdk_engine_directory}/$<TARGET_FILE_NAME:${TARGET_LIB_ENGINE}>")
get_property(sdk_targets GLOBAL PROPERTY CHERYL_SDK_TARGETS)
add_custom_target(cheryl-sdk)
add_dependencies(cheryl-sdk ${sdk_targets})
install(EXPORT CherylSdkTargets FILE CherylTargets.cmake NAMESPACE Cheryl::
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Cheryl COMPONENT CherylSDK)
configure_package_config_file("${CMAKE_CURRENT_LIST_DIR}/templates/CherylConfig.cmake.in"
    "${CHERYL_BUILD_ROOT}/CherylConfig.cmake" INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Cheryl)
write_basic_package_version_file("${CHERYL_BUILD_ROOT}/CherylConfigVersion.cmake"
    VERSION ${VERSION_PROJECT_CHERYL} COMPATIBILITY SameMajorVersion)
install(FILES "${CHERYL_BUILD_ROOT}/CherylConfig.cmake" "${CHERYL_BUILD_ROOT}/CherylConfigVersion.cmake"
    "${CMAKE_CURRENT_LIST_DIR}/CherylOptions.cmake"
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/Cheryl COMPONENT CherylSDK)
set(sdk_msvc_runtime "")
set(sdk_windows_minimum_version "")
if(WIN32)
    set(sdk_windows_minimum_version "10.0.18362")
endif()
if(MSVC)
    set(sdk_msvc_runtime "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    if(NOT sdk_msvc_runtime)
        set(sdk_msvc_runtime "$<IF:$<CONFIG:Debug>,MultiThreadedDebugDLL,MultiThreadedDLL>")
    endif()
endif()
