function(cheryl_sdk_install_target target exported_name)
    get_target_property(kind "${target}" TYPE)
    if(MSVC AND NOT kind STREQUAL "INTERFACE_LIBRARY")
        set_target_properties("${target}" PROPERTIES COMPILE_PDB_NAME "${target}"
            COMPILE_PDB_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}/sdk-symbols")
        install(FILES "${CHERYL_BUILD_ROOT}/sdk-symbols/${target}.pdb"
            DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK OPTIONAL)
    endif()
    foreach(property IN ITEMS INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
        get_target_property(includes "${target}" "${property}")
        set(build_includes)
        foreach(path IN LISTS includes)
            if(NOT path MATCHES "-NOTFOUND$")
                list(APPEND build_includes "$<BUILD_INTERFACE:${path}>")
            endif()
        endforeach()
        set_property(TARGET "${target}" PROPERTY "${property}" "${build_includes}")
    endforeach()
    target_include_directories("${target}" INTERFACE "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
    if(exported_name MATCHES "^(Engine|Startup|Workers|NativeGLFW|OpenGL|UI::|Audio::)")
        target_include_directories("${target}" INTERFACE "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/cheryl>")
    endif()
    if(exported_name STREQUAL "Engine")
        target_include_directories("${target}" INTERFACE "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/glm>")
    endif()
    get_target_property(links "${target}" INTERFACE_LINK_LIBRARIES)
    if(links)
        set(installed_links "${links}")
        if(target STREQUAL "${TARGET_LIB_CHERYL}")
            list(FILTER installed_links EXCLUDE REGEX "^\\$<BUILD_INTERFACE:")
        endif()
        get_property(names GLOBAL PROPERTY CHERYL_SDK_NAMES)
        set(replacements)
        set(replacement_index 0)
        foreach(entry IN LISTS names)
            string(REPLACE "|" ";" fields "${entry}")
            list(GET fields 0 source_name)
            list(GET fields 1 sdk_name)
            if(sdk_name MATCHES "^@NATIVE@(.*)$")
                set(replacement "${CMAKE_MATCH_1}")
            else()
                set(replacement "Cheryl::${sdk_name}")
            endif()
            # Protect replacements from subsequent canonical-name substitutions.
            # Match full target tokens, including targets nested in link expressions.
            set(placeholder "@CHERYL_SDK_TARGET_${replacement_index}@")
            set(source_pattern "${source_name}")
            foreach(character IN ITEMS "\\" "." "^" "$" "*" "+" "?" "(" ")" "[" "]" "{" "}" "|")
                string(REPLACE "${character}" "\\${character}" source_pattern "${source_pattern}")
            endforeach()
            while(TRUE)
                set(previous_links "${installed_links}")
                string(REGEX REPLACE "(^|[;,]|\\$<[A-Z_]+:|>:)${source_pattern}([;,>]|$)"
                    "\\1${placeholder}\\2" installed_links "${installed_links}")
                if(installed_links STREQUAL previous_links)
                    break()
                endif()
            endwhile()
            list(APPEND replacements "${placeholder}|${replacement}")
            math(EXPR replacement_index "${replacement_index} + 1")
        endforeach()
        foreach(entry IN LISTS replacements)
            string(REPLACE "|" ";" fields "${entry}")
            list(GET fields 0 placeholder)
            list(GET fields 1 replacement)
            string(REPLACE "${placeholder}" "${replacement}" installed_links "${installed_links}")
        endforeach()
        set_property(TARGET "${target}" PROPERTY INTERFACE_LINK_LIBRARIES
            "$<BUILD_INTERFACE:${links}>;$<INSTALL_INTERFACE:${installed_links}>")
    endif()
    get_target_property(public_headers "${target}" PUBLIC_HEADER)
    if(public_headers)
        set_property(TARGET "${target}" PROPERTY PUBLIC_HEADER "")
    endif()
    # Upstream PUBLIC_HEADER properties belong to upstream install rules. SDK
    # headers are selected explicitly below, including private static closure.
    install(TARGETS "${target}" EXPORT CherylSdkTargets
        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK
        LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK
        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT CherylSDK
        OBJECTS DESTINATION ${CMAKE_INSTALL_LIBDIR}/objects COMPONENT CherylSDK
        PUBLIC_HEADER DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/private COMPONENT CherylSDK)
    if(public_headers)
        set_property(TARGET "${target}" PROPERTY PUBLIC_HEADER "${public_headers}")
    endif()
endfunction()

