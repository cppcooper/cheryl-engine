cheryl_sdk_target(spdlog DependencySPDLog)
cheryl_sdk_target(glm-header-only DependencyGLM)
cheryl_sdk_target(backward_interface DependencyBackward)
cheryl_sdk_target(CLI11 DependencyCLI11)
cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/projects/engine/include")
cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/projects/engine/support/startup/include")
cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/extern/ctti/include")
cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/extern/spdlog/include")
cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/extern/cli11/include")
install(DIRECTORY "${CHERYL_REPOSITORY_ROOT}/extern/glm/glm" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
    COMPONENT CherylSDK FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp" PATTERN "*.inl")
install(FILES "${CHERYL_REPOSITORY_ROOT}/extern/backward-cpp/backward.hpp"
    DESTINATION ${CMAKE_INSTALL_INCLUDEDIR} COMPONENT CherylSDK)

foreach(provider IN ITEMS HWLOC JSON)
    if(CHERYL_BUILD_WORKER_TOPOLOGY_${provider})
        if(provider STREQUAL "HWLOC")
            cheryl_sdk_target(${TARGET_LIB_ENGINE_S_WORKER_TOPOLOGY_HWLOC} WorkerTopology::Hwloc)
        else()
            cheryl_sdk_target(${TARGET_LIB_ENGINE_S_WORKER_TOPOLOGY_JSON} WorkerTopology::Json)
        endif()
        cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/projects/engine/support/worker-topology/include")
    endif()
endforeach()
if(CHERYL_BUILD_NATIVE_GLFW)
    set_property(TARGET ${TARGET_LIB_MODULE_NATIVE_GLFW} APPEND PROPERTY EXPORT_PROPERTIES CHERYL_NATIVE_INPUT)
    cheryl_sdk_target(${TARGET_LIB_MODULE_NATIVE_GLFW} NativeGLFW)
    cheryl_sdk_target(glfw DependencyGLFW)
    cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/projects/modules/platform/native-glfw/include")
    cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/extern/glfw/include")
    if(CHERYL_NATIVE_INPUT)
        foreach(candidate IN LISTS LINKAGE_PUBLIC_LIB_MODULE_NATIVE_GLFW_INPUT_GAINPUT_CANDIDATES)
            if(TARGET ${candidate})
                cheryl_sdk_target(${candidate} DependencyGainput)
                break()
            endif()
        endforeach()
        cheryl_sdk_headers("${CHERYL_REPOSITORY_ROOT}/extern/gainput/lib/include")
    endif()
endif()
