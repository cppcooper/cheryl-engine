install(FILES "${CHERYL_REPOSITORY_ROOT}/LICENSE" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/cheryl
    COMPONENT CherylSDK)
install(FILES "${CHERYL_REPOSITORY_ROOT}/assets/fonts/DejaVuSansLicense.txt"
    DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/DejaVuSans COMPONENT CherylSDK)
foreach(dependency IN ITEMS ctti spdlog backward-cpp glm cli11 glfw gainput glad tgui rmlui miniaudio stb json)
    file(GLOB licenses "${CHERYL_REPOSITORY_ROOT}/extern/${dependency}/LICENSE*"
        "${CHERYL_REPOSITORY_ROOT}/extern/${dependency}/license.txt"
        "${CHERYL_REPOSITORY_ROOT}/extern/${dependency}/copying.txt")
    foreach(license IN LISTS licenses)
        if(NOT IS_DIRECTORY "${license}")
            install(FILES "${license}" DESTINATION ${CMAKE_INSTALL_DATADIR}/licenses/${dependency}
                COMPONENT CherylSDK)
        endif()
    endforeach()
endforeach()

