# Backward's optional diagnostics carry native link inputs rather than imported
# targets. Record their shared implementations without changing producer links.
if(UNIX AND NOT APPLE AND TARGET Backward::Interface)
    get_target_property(backward_links Backward::Interface INTERFACE_LINK_LIBRARIES)
    foreach(link IN LISTS backward_links)
        set(library "${link}")
        if(link MATCHES "^\\$<\\$<BOOL:([^>]+)>:([^>]+)>$")
            set(library "${CMAKE_MATCH_2}")
        endif()
        if(IS_ABSOLUTE "${library}" AND library MATCHES "\\.so(\\.[0-9.]+)?$")
            string(SHA256 identity "${library}")
            set(dependency "cheryl_shared_${identity}")
            if(NOT TARGET "${dependency}")
                add_library("${dependency}" SHARED IMPORTED GLOBAL)
                set_property(TARGET "${dependency}" PROPERTY IMPORTED_LOCATION "${library}")
            endif()
            cheryl_shared_dependency("${dependency}" OWNER "${TARGET_LIB_ENGINE}")
        elseif(IS_ABSOLUTE "${library}" AND library MATCHES "(^|/)libpthread\\.a$")
            set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_NAMES "${library}|@NATIVE@Threads::Threads")
        endif()
    endforeach()
endif()

# Shared native libraries keep the same linkage with or without SDK installation.
# Non-system libraries relocate with the SDK on both supported platforms.
get_property(sdk_shared_dependencies GLOBAL PROPERTY CHERYL_SHARED_DEPENDENCIES)
set(sdk_shared_records)
set(sdk_native_targets "")
set(sdk_external_targets)
set(sdk_runtime_present OFF)
set(sdk_native_udev OFF)
foreach(entry IN LISTS sdk_shared_dependencies)
    string(REPLACE "|" ";" fields "${entry}")
    list(GET fields 0 dependency)
    list(GET fields 1 consumer)
    get_target_property(imported "${dependency}" IMPORTED)
    get_target_property(kind "${dependency}" TYPE)
    get_target_property(system "${dependency}" CHERYL_SHARED_DEPENDENCY_SYSTEM)
    set(deployment system)
    set(artifact "")
    if(NOT kind STREQUAL "INTERFACE_LIBRARY")
        set(artifact "$<TARGET_FILE_NAME:${dependency}>")
    endif()
    if(NOT system AND NOT imported)
        string(MAKE_C_IDENTIFIER "${dependency}" identifier)
        cheryl_sdk_declare("${dependency}" "Dependency_${identifier}")
        set_property(TARGET "${dependency}" PROPERTY CHERYL_SDK_DEPENDENCY_NAME "Dependency_${identifier}")
        set(deployment sdk)
        set(sdk_runtime_present ON)
    elseif(NOT system)
        string(MAKE_C_IDENTIFIER "${dependency}" identifier)
        set(name "Native_${identifier}")
        set_property(TARGET "${dependency}" PROPERTY CHERYL_SDK_DEPENDENCY_NAME "${name}")
        set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_NAMES "${dependency}|${name}")
        get_target_property(configurations "${dependency}" IMPORTED_CONFIGURATIONS)
        foreach(configuration IN ITEMS "" ${configurations})
            set(suffix "")
            if(configuration AND NOT configuration MATCHES "-NOTFOUND$")
                string(TOUPPER "_${configuration}" suffix)
            endif()
            foreach(property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB)
                get_target_property(location "${dependency}" "${property}${suffix}")
                if(IS_ABSOLUTE "${location}")
                    set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_NAMES "${location}|${name}")
                endif()
            endforeach()
        endforeach()
        if(NOT dependency IN_LIST sdk_external_targets)
            list(APPEND sdk_external_targets "${dependency}")
            set(runtime_directory "${CMAKE_INSTALL_LIBDIR}")
            if(WIN32)
                set(runtime_directory "${CMAKE_INSTALL_BINDIR}")
            endif()
            string(APPEND sdk_native_targets
                "if(NOT TARGET Cheryl::${name})\n  add_library(Cheryl::${name} SHARED IMPORTED)\n"
                "  set_target_properties(Cheryl::${name} PROPERTIES\n"
                "    IMPORTED_LOCATION \"\${PACKAGE_PREFIX_DIR}/${runtime_directory}/$<TARGET_FILE_NAME:${dependency}>\"\n"
                "    INTERFACE_INCLUDE_DIRECTORIES \"\${PACKAGE_PREFIX_DIR}/${CMAKE_INSTALL_INCLUDEDIR}\")\n")
            if(WIN32)
                string(APPEND sdk_native_targets
                    "  set_property(TARGET Cheryl::${name} PROPERTY IMPORTED_IMPLIB \"\${PACKAGE_PREFIX_DIR}/${CMAKE_INSTALL_LIBDIR}/$<TARGET_LINKER_FILE_NAME:${dependency}>\")\n")
            endif()
            get_target_property(definitions "${dependency}" INTERFACE_COMPILE_DEFINITIONS)
            if(definitions)
                string(APPEND sdk_native_targets
                    "  set_property(TARGET Cheryl::${name} PROPERTY INTERFACE_COMPILE_DEFINITIONS \"${definitions}\")\n")
            endif()
            foreach(property IN ITEMS CHERYL_TGUI_ENGINE_SERVICES CHERYL_TGUI_IMAGE_DECODER_ABI
                    CHERYL_RMLUI_ENGINE_SERVICES CHERYL_RMLUI_RASTERIZER_ABI CHERYL_RMLUI_PLACEHOLDER_FIX)
                get_target_property(value "${dependency}" "${property}")
                if(value)
                    string(APPEND sdk_native_targets
                        "  set_property(TARGET Cheryl::${name} PROPERTY ${property} \"${value}\")\n")
                endif()
            endforeach()
            string(APPEND sdk_native_targets "endif()\n")
            if(WIN32)
                install(FILES "$<TARGET_FILE:${dependency}>" DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT CherylSDK)
                install(FILES "$<TARGET_LINKER_FILE:${dependency}>" DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT CherylSDK)
            else()
                install(CODE "file(INSTALL DESTINATION \"\${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}\" TYPE SHARED_LIBRARY FOLLOW_SYMLINK_CHAIN FILES \"$<TARGET_FILE:${dependency}>\")"
                    COMPONENT CherylSDK)
            endif()
        endif()
        set(deployment sdk)
        set(sdk_runtime_present ON)
    endif()
    if(deployment STREQUAL "sdk")
        set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_RUNTIME_LIBRARIES "$<TARGET_FILE:${dependency}>")
    endif()
    set(sdk_dependency_target "${dependency}")
    if(deployment STREQUAL "sdk")
        get_target_property(sdk_dependency_name "${dependency}" CHERYL_SDK_DEPENDENCY_NAME)
        set(sdk_dependency_target "Cheryl::${sdk_dependency_name}")
    endif()
    list(APPEND sdk_shared_records
        "{\"dependency\":\"${dependency}\",\"consumer\":\"${consumer}\",\"consumer_artifact\":\"$<TARGET_FILE_NAME:${consumer}>\",\"artifact\":\"${artifact}\",\"deployment\":\"${deployment}\",\"sdk_target\":\"${sdk_dependency_target}\"}")
endforeach()

