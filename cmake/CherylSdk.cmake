# Declare the complete map before rewriting installed link expressions. A target
# is exported once even when several public compatibility names refer to it.
function(cheryl_sdk_declare target name)
    if(NOT TARGET "${target}")
        return()
    endif()
    get_target_property(concrete "${target}" ALIASED_TARGET)
    if(NOT concrete)
        set(concrete "${target}")
    endif()
    get_property(targets GLOBAL PROPERTY CHERYL_SDK_TARGETS)
    if(NOT concrete IN_LIST targets)
        get_target_property(imported "${concrete}" IMPORTED)
        if(imported)
            message(FATAL_ERROR "SDK production requires an owned ${target}; supplied targets remain supported for source composition")
        endif()
        set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_TARGETS "${concrete}")
        set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_EXPORTS "${concrete}|${name}")
        set_target_properties("${concrete}" PROPERTIES EXPORT_NAME "${name}")
    endif()
    set_property(GLOBAL APPEND PROPERTY CHERYL_SDK_NAMES "${target}|${name}" "${concrete}|${name}")
endfunction()

