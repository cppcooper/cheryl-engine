include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/CherylOptions.cmake")
cheryl_configure_library_options()

set(CHERYL_LIBRARY_TYPE STATIC)
if(CHERYL_BUILD_SHARED_LIBS)
    set(CHERYL_LIBRARY_TYPE SHARED)
    # Owned static dependencies may be incorporated into a Cheryl shared library.
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()

function(cheryl_configure_library target component)
    get_target_property(kind ${target} TYPE)
    get_target_property(version ${target} VERSION)
    get_target_property(output_name ${target} OUTPUT_NAME)
    set_target_properties(${target} PROPERTIES
        DEFINE_SYMBOL "CE_BUILDING_${component}"
        LIBRARY_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}"
        RUNTIME_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}")
    if(kind STREQUAL "STATIC_LIBRARY")
        target_compile_definitions(${target} PUBLIC "CE_${component}_STATIC")
    else()
        set_target_properties(${target} PROPERTIES
            CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
        if(version)
            string(REGEX MATCH "^[0-9]+" abi_version "${version}")
            set_target_properties(${target} PROPERTIES SOVERSION "${abi_version}")
        endif()
        if(UNIX AND NOT APPLE)
            set_target_properties(${target} PROPERTIES INSTALL_RPATH "$ORIGIN")
        elseif(APPLE)
            set_target_properties(${target} PROPERTIES INSTALL_RPATH "@loader_path")
        endif()
        if(NOT component STREQUAL "ENGINE" AND TARGET Cheryl::Engine)
            get_target_property(engine_type Cheryl::Engine TYPE)
            if(engine_type STREQUAL "STATIC_LIBRARY")
                message(FATAL_ERROR "Shared Cheryl components require a shared Cheryl::Engine")
            endif()
        endif()
    endif()
    if(version AND output_name AND (kind STREQUAL "STATIC_LIBRARY" OR WIN32))
        set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output_name}-${version}")
    endif()
endfunction()

function(cheryl_shared_dependency target)
    cmake_parse_arguments(dependency "OWNED" "" "" ${ARGN})
    if(NOT CHERYL_BUILD_SHARED_LIBS)
        return()
    endif()
    get_target_property(concrete ${target} ALIASED_TARGET)
    if(NOT concrete)
        set(concrete "${target}")
    endif()
    get_target_property(kind ${concrete} TYPE)
    if(kind STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "Shared Cheryl requires a shared ${target}; supply a shared dependency or let Cheryl build its source")
    endif()
    get_target_property(imported ${concrete} IMPORTED)
    if(dependency_OWNED AND NOT imported AND kind STREQUAL "SHARED_LIBRARY")
        set_target_properties(${concrete} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}"
            LIBRARY_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}")
        if(UNIX AND NOT APPLE)
            set_target_properties(${concrete} PROPERTIES INSTALL_RPATH "$ORIGIN")
        elseif(APPLE)
            set_target_properties(${concrete} PROPERTIES INSTALL_RPATH "@loader_path")
        endif()
    endif()
endfunction()
