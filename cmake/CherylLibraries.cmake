include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/CherylOptions.cmake")
cheryl_configure_library_options()

set(CHERYL_LIBRARY_TYPE STATIC)
if(CHERYL_BUILD_SHARED_LIBS)
    set(CHERYL_LIBRARY_TYPE SHARED)
    # Owned static dependencies may be incorporated into a Cheryl shared library.
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()

function(cheryl_configure_library target component)
    get_target_property(kind ${target} TYPE)
    get_target_property(version ${target} VERSION)
    get_target_property(output_name ${target} OUTPUT_NAME)
    set_target_properties(${target} PROPERTIES
        DEFINE_SYMBOL "CE_BUILDING_${component}"
        LIBRARY_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}"
        RUNTIME_OUTPUT_DIRECTORY "${CHERYL_BUILD_ROOT}")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        file(MAKE_DIRECTORY "${CHERYL_BUILD_ROOT}/link-maps")
        target_link_options(${target} PRIVATE "LINKER:-Map,${CHERYL_BUILD_ROOT}/link-maps/${target}.map")
    elseif(MSVC)
        target_link_options(${target} PRIVATE "/MAP:${CHERYL_BUILD_ROOT}/${target}.map")
    endif()
    if(kind STREQUAL "STATIC_LIBRARY")
        target_compile_definitions(${target} PUBLIC "CE_${component}_STATIC")
    else()
        set_target_properties(${target} PROPERTIES
            CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
        if(version)
            string(REGEX MATCH "^[0-9]+" abi_version "${version}")
            set_target_properties(${target} PROPERTIES SOVERSION "${abi_version}")
        endif()
        if(UNIX AND NOT APPLE)
            set_target_properties(${target} PROPERTIES INSTALL_RPATH "$ORIGIN")
        elseif(APPLE)
            set_target_properties(${target} PROPERTIES INSTALL_RPATH "@loader_path")
        endif()
        if(NOT component STREQUAL "ENGINE" AND TARGET Cheryl::Engine)
            get_target_property(engine_type Cheryl::Engine TYPE)
            if(engine_type STREQUAL "STATIC_LIBRARY")
                message(FATAL_ERROR "Shared Cheryl components require a shared Cheryl::Engine")
            endif()
        endif()
    endif()
    if(version AND output_name AND (kind STREQUAL "STATIC_LIBRARY" OR WIN32))
        set_target_properties(${target} PROPERTIES OUTPUT_NAME "${output_name}-${version}")
    endif()
endfunction()

function(cheryl_write_dependency_inventory)
    get_property(dependencies GLOBAL PROPERTY CHERYL_PRIVATE_DEPENDENCIES)
    set(entries)
    foreach(declaration IN LISTS dependencies)
        string(REPLACE "|" ";" fields "${declaration}")
        list(GET fields 0 dependency)
        list(GET fields 1 owner)
        list(APPEND entries "{\"dependency\":\"${dependency}\",\"target_owner\":\"${owner}\",\"archive\":\"$<TARGET_FILE:${dependency}>\",\"binary\":\"$<TARGET_FILE:${owner}>\"}")
    endforeach()
    list(JOIN entries ",\n" records)
    file(GENERATE OUTPUT "${CHERYL_BUILD_ROOT}/cheryl-dependency-ownership.json"
        CONTENT "{\"schema\":1,\"dependencies\":[\n${records}\n]}\n")

    get_property(shared_dependencies GLOBAL PROPERTY CHERYL_SHARED_DEPENDENCIES)
    set(entries)
    foreach(declaration IN LISTS shared_dependencies)
        string(REPLACE "|" ";" fields "${declaration}")
        list(GET fields 0 dependency)
        list(GET fields 1 consumer)
        get_target_property(kind "${dependency}" TYPE)
        get_target_property(system "${dependency}" CHERYL_SHARED_DEPENDENCY_SYSTEM)
        get_target_property(owned "${dependency}" CHERYL_OWNED_DEPENDENCY)
        set(library "")
        if(NOT kind STREQUAL "INTERFACE_LIBRARY")
            set(library "$<TARGET_FILE:${dependency}>")
        endif()
        list(APPEND entries "{\"dependency\":\"${dependency}\",\"consumer\":\"${consumer}\",\"library\":\"${library}\",\"system\":$<IF:$<BOOL:${system}>,true,false>,\"owned\":$<IF:$<BOOL:${owned}>,true,false>}")
    endforeach()
    list(JOIN entries ",\n" records)
    file(GENERATE OUTPUT "${CHERYL_BUILD_ROOT}/cheryl-shared-dependencies.json"
        CONTENT "{\"schema\":1,\"dependencies\":[\n${records}\n]}\n")
endfunction()


# Platform runtime archives are external system inputs, including glibc's empty
# compatibility archives. A system directory alone never exempts a private SDK.
function(cheryl_is_system_archive result path)
    set(${result} OFF PARENT_SCOPE)
    string(REPLACE "\\" "/" normalized "${path}")
    cmake_path(NORMAL_PATH normalized)
    get_filename_component(name "${normalized}" NAME)
    if(UNIX AND name MATCHES "^lib(c|c_nonshared|m|dl|rt|pthread)\\.a$")
        set(system_directories /lib /lib64 /usr/lib /usr/lib64
            ${CMAKE_PLATFORM_IMPLICIT_LINK_DIRECTORIES}
            ${CMAKE_C_IMPLICIT_LINK_DIRECTORIES} ${CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES})
        foreach(root IN ITEMS "${CMAKE_SYSROOT}" ${CMAKE_FIND_ROOT_PATH})
            if(root)
                list(APPEND system_directories "${root}/lib" "${root}/lib64" "${root}/usr/lib" "${root}/usr/lib64")
            endif()
        endforeach()
        foreach(directory IN LISTS system_directories)
            cmake_path(IS_PREFIX directory "${normalized}" NORMALIZE within_system)
            if(within_system)
                set(${result} ON PARENT_SCOPE)
                return()
            endif()
        endforeach()
    elseif(WIN32)
        string(TOLOWER "${normalized}" normalized)
        string(TOLOWER "${name}" name)
        if(normalized MATCHES "/(windows kits/[0-9.]+|microsoft sdks/windows/v[0-9.a-z]+)/lib/" AND
                name MATCHES "^(advapi32|bcrypt|cfgmgr32|comctl32|comdlg32|crypt32|dbghelp|dnsapi|d3d11|d3d12|dwmapi|dxgi|dxguid|gdi32|glu32|hid|imm32|iphlpapi|kernel32|netapi32|ncrypt|normaliz|ntdll|ole32|oleaut32|opengl32|powrprof|psapi|secur32|setupapi|shell32|shlwapi|ucrt|ucrtd|user32|uuid|version|wbemuuid|windowscodecs|winmm|winspool|winusb|ws2_32)\\.lib$")
            set(${result} ON PARENT_SCOPE)
        endif()
    endif()
endfunction()

# Shared dependencies own their implementations in their own runtime libraries.
# OWNER names the Cheryl consumer, independently of development or SDK selection.
function(cheryl_shared_dependency target)
    cmake_parse_arguments(dependency "OWNED;SYSTEM" "OWNER" "" ${ARGN})
    if(NOT dependency_OWNER OR NOT TARGET "${dependency_OWNER}" OR NOT TARGET "${target}")
        message(FATAL_ERROR "cheryl_shared_dependency requires an existing dependency and OWNER target")
    endif()
    get_target_property(concrete "${target}" ALIASED_TARGET)
    if(NOT concrete)
        set(concrete "${target}")
    endif()
    get_target_property(consumer "${dependency_OWNER}" ALIASED_TARGET)
    if(NOT consumer)
        set(consumer "${dependency_OWNER}")
    endif()
    string(SHA256 identity "${concrete}")
    set_property(GLOBAL PROPERTY "CHERYL_SHARED_ADMITTED_${identity}" TRUE)
    get_target_property(kind "${concrete}" TYPE)
    get_target_property(imported "${concrete}" IMPORTED)
    if(dependency_OWNED AND imported)
        message(FATAL_ERROR "OWNED cannot change the imported dependency ${target}")
    endif()
    if(kind STREQUAL "INTERFACE_LIBRARY" AND NOT dependency_SYSTEM)
        get_target_property(links "${concrete}" INTERFACE_LINK_LIBRARIES)
        set(found OFF)
        foreach(link IN LISTS links)
            if(TARGET "${link}")
                cheryl_shared_dependency("${link}" OWNER "${consumer}")
                set(found ON)
            elseif(IS_ABSOLUTE "${link}" AND link MATCHES "\\.(so(\\.[0-9.]+)?|dylib|dll)$")
                string(SHA256 library_identity "${link}")
                set(library "cheryl_shared_${library_identity}")
                if(NOT TARGET "${library}")
                    add_library("${library}" SHARED IMPORTED GLOBAL)
                    set_target_properties("${library}" PROPERTIES IMPORTED_LOCATION "${link}")
                endif()
                cheryl_shared_dependency("${library}" OWNER "${consumer}")
                set(found ON)
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Cannot establish a shared implementation behind ${target}")
        endif()
        return()
    elseif(kind STREQUAL "UNKNOWN_LIBRARY")
        get_target_property(configurations "${concrete}" IMPORTED_CONFIGURATIONS)
        set(locations)
        foreach(configuration IN ITEMS "" ${configurations})
            set(suffix "")
            if(configuration)
                string(TOUPPER "_${configuration}" suffix)
            endif()
            get_target_property(location "${concrete}" "IMPORTED_LOCATION${suffix}")
            if(location)
                list(APPEND locations "${location}")
            endif()
        endforeach()
        if(NOT locations)
            message(FATAL_ERROR "Cannot establish the shared implementation of ${target}")
        endif()
        foreach(location IN LISTS locations)
            if(WIN32 AND location MATCHES "\\.[lL][iI][bB]$")
                message(FATAL_ERROR
                    "${target} needs an imported SHARED target with its runtime DLL in IMPORTED_LOCATION and its import library in IMPORTED_IMPLIB; ${location} alone cannot describe DLL deployment")
            elseif(NOT location MATCHES "\\.(so(\\.[0-9.]+)?|dylib|dll)$")
                message(FATAL_ERROR "${target} requires a shared implementation; found ${location}")
            endif()
        endforeach()
    elseif(NOT kind STREQUAL "SHARED_LIBRARY" AND NOT (kind STREQUAL "INTERFACE_LIBRARY" AND dependency_SYSTEM))
        message(FATAL_ERROR "${target} requires a shared implementation; found ${kind}")
    endif()
    if(dependency_OWNED)
        set_property(TARGET "${concrete}" PROPERTY CHERYL_OWNED_DEPENDENCY TRUE)
    endif()
    if(dependency_SYSTEM)
        set_property(TARGET "${concrete}" PROPERTY CHERYL_SHARED_DEPENDENCY_SYSTEM TRUE)
    endif()
    get_property(declarations GLOBAL PROPERTY CHERYL_SHARED_DEPENDENCIES)
    set(declaration "${concrete}|${consumer}")
    if(NOT declaration IN_LIST declarations)
        set_property(GLOBAL APPEND PROPERTY CHERYL_SHARED_DEPENDENCIES "${declaration}")
    endif()
endfunction()

# A compiled external implementation belongs to one Cheryl binary. Supplied
# targets are inspected without changing their build or interface settings.
function(cheryl_private_dependency target)
    cmake_parse_arguments(dependency "OWNED;PUBLIC_API;TRANSITIVE" "OWNER;RESULT" "" ${ARGN})
    if(dependency_RESULT)
        set(${dependency_RESULT} OFF PARENT_SCOPE)
    endif()
    if(NOT dependency_OWNER OR NOT TARGET "${dependency_OWNER}" OR NOT TARGET "${target}")
        message(FATAL_ERROR "cheryl_private_dependency requires an existing dependency and OWNER target")
    endif()
    get_target_property(concrete "${target}" ALIASED_TARGET)
    if(NOT concrete)
        set(concrete "${target}")
    endif()
    get_target_property(owner "${dependency_OWNER}" ALIASED_TARGET)
    if(NOT owner)
        set(owner "${dependency_OWNER}")
    endif()
    if(dependency_TRANSITIVE)
        get_property(public_components GLOBAL PROPERTY CHERYL_AVAILABLE_COMPONENTS)
        if(concrete IN_LIST public_components OR target MATCHES "^(Threads|X11|OpenGL)::")
            return()
        endif()
    endif()
    string(SHA256 identity "${concrete}")
    get_property(shared_dependency GLOBAL PROPERTY "CHERYL_SHARED_ADMITTED_${identity}")
    if(dependency_TRANSITIVE AND shared_dependency)
        return()
    endif()
    get_property(previous_owner GLOBAL PROPERTY "CHERYL_DEPENDENCY_OWNER_${identity}")
    if(previous_owner AND NOT previous_owner STREQUAL owner)
        message(FATAL_ERROR "${target} already belongs to ${previous_owner}; it cannot also belong to ${owner}")
    endif()
    get_target_property(kind "${concrete}" TYPE)
    get_target_property(imported "${concrete}" IMPORTED)
    if(dependency_OWNED AND imported)
        message(FATAL_ERROR "OWNED cannot change the imported dependency ${target}")
    endif()
    set(found_implementation OFF)
    set(locations)
    if(kind STREQUAL "INTERFACE_LIBRARY")
        # Header-only children are valid; a top-level wrapper must lead to an archive.
    elseif(kind STREQUAL "OBJECT_LIBRARY")
        message(FATAL_ERROR "${owner} requires an archive dependency; OBJECT_LIBRARY ${target} is not supported")
    elseif(kind STREQUAL "UNKNOWN_LIBRARY")
        get_target_property(configurations "${concrete}" IMPORTED_CONFIGURATIONS)
        foreach(configuration IN ITEMS "" ${configurations})
            set(suffix "")
            if(configuration)
                string(TOUPPER "_${configuration}" suffix)
            endif()
            get_target_property(location "${concrete}" "IMPORTED_LOCATION${suffix}")
            get_target_property(import_library "${concrete}" "IMPORTED_IMPLIB${suffix}")
            if(import_library)
                message(FATAL_ERROR "${target} supplies a shared-library import; ${owner} needs a static implementation")
            endif()
            if(location)
                list(APPEND locations "${location}")
            endif()
        endforeach()
        if(NOT locations)
            message(FATAL_ERROR "Cannot establish the static implementation of ${target}")
        endif()
        foreach(location IN LISTS locations)
            if(NOT location MATCHES "\\.([aA]|[lL][iI][bB])$")
                message(FATAL_ERROR "${owner} requires a static ${target}; found ${location}. Prepare static dependencies or supply compatible static targets.")
            endif()
        endforeach()
        set(found_implementation ON)
    elseif(kind STREQUAL "STATIC_LIBRARY")
        set(found_implementation ON)
    else()
        message(FATAL_ERROR "${owner} requires a static ${target}; found ${kind}. Prepare static dependencies or supply compatible static targets.")
    endif()

    # Break cycles by owner and concrete target. Compiled nodes still count as
    # implementations when reached through an in-progress static dependency cycle.
    string(SHA256 visit_identity "${owner}|${concrete}")
    get_property(visiting GLOBAL PROPERTY "CHERYL_DEPENDENCY_VISITING_${visit_identity}")
    if(visiting)
        if(dependency_RESULT)
            set(${dependency_RESULT} "${found_implementation}" PARENT_SCOPE)
        endif()
        return()
    endif()
    set_property(GLOBAL PROPERTY "CHERYL_DEPENDENCY_VISITING_${visit_identity}" TRUE)

    if(imported AND kind STREQUAL "STATIC_LIBRARY")
        get_target_property(configurations "${concrete}" IMPORTED_CONFIGURATIONS)
        foreach(configuration IN ITEMS "" ${configurations})
            set(suffix "")
            if(configuration)
                string(TOUPPER "_${configuration}" suffix)
            endif()
            get_target_property(location "${concrete}" "IMPORTED_LOCATION${suffix}")
            if(location)
                list(APPEND locations "${location}")
            endif()
        endforeach()
    endif()
    foreach(location IN LISTS locations)
        get_filename_component(archive "${location}" ABSOLUTE)
        if(EXISTS "${location}")
            file(REAL_PATH "${location}" archive)
        endif()
        if(WIN32)
            string(TOLOWER "${archive}" archive)
        endif()
        string(SHA256 archive_identity "${archive}")
        get_property(archive_owner GLOBAL PROPERTY "CHERYL_ARCHIVE_OWNER_${archive_identity}")
        if(archive_owner AND NOT archive_owner STREQUAL owner)
            message(FATAL_ERROR "The archive ${location} already belongs to ${archive_owner}; it cannot also belong to ${owner}")
        endif()
        set_property(GLOBAL PROPERTY "CHERYL_ARCHIVE_OWNER_${archive_identity}" "${owner}")
    endforeach()
    if(NOT kind STREQUAL "INTERFACE_LIBRARY")
        if(dependency_OWNED)
            set_target_properties("${concrete}" PROPERTIES POSITION_INDEPENDENT_CODE ON
                C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
        endif()
        get_target_property(owner_kind ${owner} TYPE)
        set(exclusion "LINKER:--exclude-libs,$<TARGET_FILE_NAME:${concrete}>")
        get_property(public_api GLOBAL PROPERTY "CHERYL_DEPENDENCY_PUBLIC_API_${identity}")
        if(dependency_PUBLIC_API)
            set(public_api TRUE)
            set_property(GLOBAL PROPERTY "CHERYL_DEPENDENCY_PUBLIC_API_${identity}" TRUE)
            get_target_property(owner_options "${owner}" LINK_OPTIONS)
            if(owner_options)
                list(REMOVE_ITEM owner_options "${exclusion}")
                set_property(TARGET "${owner}" PROPERTY LINK_OPTIONS "${owner_options}")
            endif()
        endif()
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND owner_kind STREQUAL "SHARED_LIBRARY" AND NOT public_api)
            target_link_options(${owner} PRIVATE "${exclusion}")
        endif()
        set_property(GLOBAL PROPERTY "CHERYL_DEPENDENCY_OWNER_${identity}" "${owner}")
        if(NOT previous_owner)
            set_property(GLOBAL APPEND PROPERTY CHERYL_PRIVATE_DEPENDENCIES "${concrete}|${owner}")
        endif()
    endif()

    get_target_property(interface_links "${concrete}" INTERFACE_LINK_LIBRARIES)
    get_target_property(direct_links "${concrete}" LINK_LIBRARIES)
    set(links ${interface_links} ${direct_links})
    list(REMOVE_DUPLICATES links)
    foreach(link IN LISTS links)
        # These wrappers do not change ownership. Inspect configuration branches
        # conservatively so every archive a supported configuration can use counts.
        while(link MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE|TARGET_NAME_IF_EXISTS):(.*)>$")
            set(link "${CMAKE_MATCH_2}")
        endwhile()
        if(link MATCHES "^\\$<INSTALL_INTERFACE:.*>$")
            continue()
        endif()
        if(link MATCHES "[<>]")
            # Flatten remaining generator syntax into candidate link items while
            # retaining namespaced target spellings. This also covers conditional
            # branches, LINK_LIBRARY and LINK_GROUP without evaluating build config.
            string(REPLACE "::" "@CHERYL_NAMESPACE@" candidates "${link}")
            string(REGEX REPLACE "[<>:,]" ";" candidates "${candidates}")
            string(REPLACE "$" "" candidates "${candidates}")
            string(REPLACE "@CHERYL_NAMESPACE@" "::" candidates "${candidates}")
        else()
            set(candidates "${link}")
        endif()
        foreach(candidate IN LISTS candidates)
            if(TARGET "${candidate}")
                set(child_options TRANSITIVE)
                if(dependency_PUBLIC_API)
                    list(APPEND child_options PUBLIC_API)
                endif()
                cheryl_private_dependency("${candidate}" OWNER "${owner}" ${child_options} RESULT child_implementation)
                if(child_implementation)
                    set(found_implementation ON)
                endif()
            elseif(IS_ABSOLUTE "${candidate}" AND candidate MATCHES "\\.([aA]|[lL][iI][bB])$")
                cheryl_is_system_archive(system_archive "${candidate}")
                if(NOT system_archive)
                    message(FATAL_ERROR
                        "${target} links unidentified archive ${candidate}. Supply an imported STATIC or UNKNOWN target so Cheryl can validate its ownership.")
                endif()
            endif()
        endforeach()
    endforeach()
    set_property(GLOBAL PROPERTY "CHERYL_DEPENDENCY_VISITING_${visit_identity}" FALSE)
    if(kind STREQUAL "INTERFACE_LIBRARY" AND NOT found_implementation AND NOT dependency_TRANSITIVE)
        message(FATAL_ERROR "Cannot establish a static implementation behind ${target}")
    endif()
    if(dependency_RESULT)
        set(${dependency_RESULT} "${found_implementation}" PARENT_SCOPE)
    endif()
endfunction()
