include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CherylTargets.cmake")

# Keep the umbrella's feature set aligned with target usage requirements in both
# source assemblies and installed SDKs. Engine itself remains dependency-neutral.
function(cheryl_register_public_component target)
    cmake_parse_arguments(component "BUILD_ONLY" "FEATURE" "" ${ARGN})
    if(component_FEATURE)
        target_compile_definitions(${target} INTERFACE "${component_FEATURE}=1")
    endif()
    if(NOT TARGET Cheryl::Cheryl)
        add_library(${TARGET_LIB_CHERYL} INTERFACE)
        add_library(Cheryl::Cheryl ALIAS ${TARGET_LIB_CHERYL})
        set_property(TARGET ${TARGET_LIB_CHERYL} PROPERTY CHERYL_OWNED_ASSEMBLY TRUE)
        target_link_libraries(${TARGET_LIB_CHERYL} INTERFACE Cheryl::Engine)
    endif()
    set_property(GLOBAL APPEND PROPERTY CHERYL_AVAILABLE_COMPONENTS "${target}")
    set_property(TARGET ${target} PROPERTY CHERYL_COMPONENT_BUILD_ONLY "${component_BUILD_ONLY}")
endfunction()

function(cheryl_select_public_component target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Cannot select unavailable Cheryl component ${target}")
    endif()
    get_target_property(concrete "${target}" ALIASED_TARGET)
    if(NOT concrete)
        set(concrete "${target}")
    endif()
    get_target_property(assembly Cheryl::Cheryl ALIASED_TARGET)
    if(NOT assembly)
        set(assembly Cheryl::Cheryl)
    endif()
    get_target_property(owned_assembly ${assembly} CHERYL_OWNED_ASSEMBLY)
    if(NOT owned_assembly)
        return() # Supplied assemblies retain their original component selection.
    endif()
    get_property(selected GLOBAL PROPERTY CHERYL_SELECTED_COMPONENTS)
    if(concrete IN_LIST selected)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY CHERYL_SELECTED_COMPONENTS "${concrete}")
    if(NOT concrete STREQUAL "${TARGET_LIB_ENGINE}")
        get_target_property(build_only ${concrete} CHERYL_COMPONENT_BUILD_ONLY)
        if(build_only)
            target_link_libraries(${assembly} INTERFACE "$<BUILD_INTERFACE:${concrete}>")
        else()
            target_link_libraries(${assembly} INTERFACE ${concrete})
        endif()
    endif()
endfunction()
