include_guard(GLOBAL)

# Keep the umbrella's feature set aligned with target usage requirements in both
# source assemblies and installed SDKs. Engine itself remains dependency-neutral.
function(cheryl_register_public_component target)
    cmake_parse_arguments(component "BUILD_ONLY" "FEATURE" "" ${ARGN})
    if(component_FEATURE)
        target_compile_definitions(${target} INTERFACE "${component_FEATURE}=1")
    endif()
    if(NOT TARGET Cheryl::Cheryl)
        add_library(${TARGET_LIB_CHERYL} INTERFACE)
        add_library(Cheryl::Cheryl ALIAS ${TARGET_LIB_CHERYL})
        set_property(TARGET ${TARGET_LIB_CHERYL} PROPERTY CHERYL_OWNED_ASSEMBLY TRUE)
        target_link_libraries(${TARGET_LIB_CHERYL} INTERFACE Cheryl::Engine)
    endif()
    get_target_property(assembly Cheryl::Cheryl ALIASED_TARGET)
    if(NOT assembly)
        set(assembly Cheryl::Cheryl)
    endif()
    get_target_property(owned_assembly ${assembly} CHERYL_OWNED_ASSEMBLY)
    if(NOT owned_assembly)
        return() # Supplied assemblies retain their original component selection.
    endif()
    if(NOT target STREQUAL "${TARGET_LIB_ENGINE}")
        if(component_BUILD_ONLY)
            target_link_libraries(${assembly} INTERFACE "$<BUILD_INTERFACE:${target}>")
        else()
            target_link_libraries(${assembly} INTERFACE ${target})
        endif()
    endif()
endfunction()
