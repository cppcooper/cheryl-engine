---
Language: Cpp
BasedOnStyle: LLVM

# Cheryl Engine C++ style.
# Target: CLion 2026.2 bundled clang-format 22.0.0git.
# Derived from the CLion code-style scheme and the current repository style.

# Width / indentation
IndentWidth: 4
ContinuationIndentWidth: 4
BracedInitializerIndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 140

# Namespace bodies are indented in Cheryl.
NamespaceIndentation: All
CompactNamespaces: false
AllowShortNamespacesOnASingleLine: false

# Access labels line up with the class/struct indentation level.
AccessModifierOffset: -4
IndentAccessModifiers: false
EmptyLineAfterAccessModifier: Leave
EmptyLineBeforeAccessModifier: Leave

# Braces / compact forms
BreakBeforeBraces: Attach
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
InsertBraces: false

# Pointer/reference spelling used throughout Cheryl.
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer

# Preserve the repository's hand-organized include groups/order.
SortIncludes: Never
IncludeBlocks: Preserve

# Function declarations / definitions.
# Keep short signatures on one line. If a parameter list exceeds the column
# limit, wrap it as a block with one parameter per line.
BreakFunctionDefinitionParameters: false
BinPackParameters: OnePerLine
AllowAllParametersOfDeclarationOnNextLine: false

# Lists that exceed the column limit break after '(' and before ')'. These
# conditional rules apply to declarations, definitions, and function calls.
# The bundled formatter also applies this rule to braced initializer lists.
AlignAfterOpenBracket: BlockIndent

# Function calls can pack multiple arguments per line inside a wrapped block.
BinPackArguments: true
AllowAllArgumentsOnNextLine: true

# Braced initializer lists: WRAP IF LONG, DO NOT AUTOMATICALLY CHOP.
# C++11 braced lists are formatted like function calls, so values are packed
# onto each line up to ColumnLimit rather than forced one-per-line.
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false

# Constructor initializer lists remain a distinct policy: move to the next
# line and chop only when they no longer fit there.
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLineOnly
ConstructorInitializerIndentWidth: 0

# Inheritance / expressions
BreakInheritanceList: AfterComma
BreakBeforeTernaryOperators: true

# switch / case
IndentCaseLabels: true

# Avoid formatter churn in comments and strings that were intentionally laid out.
ReflowComments: false
BreakStringLiterals: false

# Whitespace preservation
MaxEmptyLinesToKeep: 1
FixNamespaceComments: false

...
