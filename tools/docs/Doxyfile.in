PROJECT_NAME           = "Cheryl Engine"
PROJECT_NUMBER         = @REVISION@
OUTPUT_DIRECTORY       = @OUTPUT@
INPUT                  = @INPUT@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.inl *.ipp *.tpp
RECURSIVE              = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
# Implementation namespaces are source-linked rather than published as API pages.
EXCLUDE_SYMBOLS        = "CE::Text::Detail" "CE::Text::Detail::*" \
                         "CE::Input::Detail" "CE::Input::Detail::*" \
                         "CE::Engine::ContextDetail" "CE::Engine::ContextDetail::*" \
                         "CE::Engine::WorkerDetail" "CE::Engine::WorkerDetail::*" \
                         "CE::GFramework::RuntimeDetail" "CE::GFramework::RuntimeDetail::*" \
                         "CE::RenderAPIs::RendererDetail" "CE::RenderAPIs::RendererDetail::*" \
                         "CE::RenderAPIs::ResourceDetail" "CE::RenderAPIs::ResourceDetail::*" \
                         "CE::DisplayDetail" "CE::DisplayDetail::*" \
                         "CE::LogDetail" "CE::LogDetail::*" \
                         "spdlog::CE" "spdlog::CE::*" \
                         "CE::Audio::Miniaudio::Detail" "CE::Audio::Miniaudio::Detail::*" \
                         "CE::math::Detail" "CE::math::Detail::*" \
                         "ASSET2D_H"
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
INLINE_INHERITED_MEMB  = NO
SORT_MEMBER_DOCS       = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @REPO_ROOT@
STRIP_FROM_INC_PATH    = @INCLUDE_ROOTS@
SHOW_INCLUDE_FILES     = YES

ENABLE_PREPROCESSING   = YES
PREDEFINED            = CHERYL_NATIVE_INPUT=1
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = NO
CLANG_ASSISTED_PARSING = NO

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
