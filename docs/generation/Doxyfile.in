PROJECT_NAME           = "Cheryl Engine"
PROJECT_NUMBER         = @REVISION@
OUTPUT_DIRECTORY       = @OUTPUT@
INPUT                  = @INPUT@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.inl *.ipp *.tpp
RECURSIVE              = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
# Implementation namespaces are source-linked rather than published as API pages.
EXCLUDE_SYMBOLS        = "CE::Text::Detail" "CE::Text::Detail::*" \
                         "CE::Text::Legacy::Detail" "CE::Text::Legacy::Detail::*" \
                         "CE::Input::Capture::Detail" "CE::Input::Capture::Detail::*" \
                         "CE::Input::Routing::Detail" "CE::Input::Routing::Detail::*" \
                         "CE::Runtime::Detail" "CE::Runtime::Detail::*" \
                         "CE::Workers::Detail" "CE::Workers::Detail::*" \
                         "CE::Events::Detail" "CE::Events::Detail::*" \
                         "CE::Rendering::OpenGL::Detail" "CE::Rendering::OpenGL::Detail::*" \
                         "CE::Platform::GLFW::Detail" "CE::Platform::GLFW::Detail::*" \
                         "CE::Platform::Linux::DebugTerminal::Detail" "CE::Platform::Linux::DebugTerminal::Detail::*" \
                         "CE::Application::DebugTerminal::Detail" "CE::Application::DebugTerminal::Detail::*" \
                         "CE::Logging::Detail" "CE::Logging::Detail::*" \
                         "CE::Diagnostics::Detail" "CE::Diagnostics::Detail::*" \
                         "CE::Assets::Manifests::Detail" "CE::Assets::Manifests::Detail::*" \
                         "CE::Audio::Miniaudio::Detail" "CE::Audio::Miniaudio::Detail::*" \
                         "CE::Math::Detail" "CE::Math::Detail::*" \
                         "ASSET2D_H"
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
INLINE_INHERITED_MEMB  = NO
SORT_MEMBER_DOCS       = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @REPO_ROOT@
STRIP_FROM_INC_PATH    = @INCLUDE_ROOTS@
SHOW_INCLUDE_FILES     = YES

ENABLE_PREPROCESSING   = YES
# Visibility decorators do not belong to the documented C++ declarations.
# Expand only these definitions so other public macros retain their spelling.
PREDEFINED            = CHERYL_NATIVE_INPUT=1 \
                         CE_DETAIL_EXPORT= CE_DETAIL_IMPORT= CE_TYPE_API= CE_API= \
                         CE_NATIVE_GLFW_API= CE_OPENGL_API= \
                         CE_UI_TGUI_API= CE_UI_RMLUI_API= CE_AUDIO_MINIAUDIO_API= \
                         CE_STARTUP_API= CE_OPENGL_STARTUP_API= CE_DEBUG_TERMINAL_API= \
                         CE_WORKER_TOPOLOGY_HWLOC_API= CE_WORKER_TOPOLOGY_JSON_API= CE_WORKERS_API=
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
CLANG_ASSISTED_PARSING = NO

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS_PRINT
