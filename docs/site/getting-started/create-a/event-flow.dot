digraph EventFlow {
    graph [rankdir=TB, bgcolor="#ffffff", pad=0.2, ranksep=0.35, nodesep=0.35];
    node [shape=box, style="rounded,filled", fillcolor="#f3f6fa",
          color="#526174", fontcolor="#253346", fontname="sans-serif", fontsize=13];
    edge [color="#526174", fontcolor="#253346", fontname="sans-serif", fontsize=12];

    gameplay [label="Gameplay code\nApply 13 damage; health becomes 87"];
    bus [label="engine.events()\nRoute by channel name + payload type"];
    hud [label="HUD listener\nDisplay health: 87"];
    sound [label="Sound listener (optional)\nReact to the damage"];

    gameplay -> bus [label="notify(damage_taken,\nDamageTaken{13, 87})"];
    bus -> hud [label="const DamageTaken&"];
    bus -> sound [label="const DamageTaken&"];
    { rank=same; hud; sound; }
}
