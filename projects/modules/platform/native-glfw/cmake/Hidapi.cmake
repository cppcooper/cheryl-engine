function(cheryl_prepare_native_hidapi owned_result)
    set(${owned_result} OFF PARENT_SCOPE)
    if(TARGET hidapi::hidapi)
        return()
    endif()

    find_package(hidapi CONFIG QUIET GLOBAL)
    if(TARGET hidapi::hidapi)
        return()
    endif()
    if(UNIX AND NOT APPLE)
        set(hidapi_backend hidapi-hidraw)
        if(DEFINED HIDAPI_WITH_HIDRAW AND NOT HIDAPI_WITH_HIDRAW)
            if(DEFINED HIDAPI_WITH_LIBUSB AND NOT HIDAPI_WITH_LIBUSB)
                message(FATAL_ERROR "Native HID support requires an enabled HIDAPI backend")
            endif()
            set(hidapi_backend hidapi-libusb)
        endif()
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(CHERYL_NATIVE_HIDAPI QUIET IMPORTED_TARGET GLOBAL ${hidapi_backend})
        if(TARGET PkgConfig::CHERYL_NATIVE_HIDAPI)
            add_library(hidapi::hidapi ALIAS PkgConfig::CHERYL_NATIVE_HIDAPI)
            return()
        endif()
    endif()

    include(FetchContent)
    block(SCOPE_FOR VARIABLES)
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        set(BUILD_SHARED_LIBS ON)
        set(HIDAPI_BUILD_HIDTEST OFF)
        set(HIDAPI_WITH_TESTS OFF)
        set(HIDAPI_BUILD_PP_DATA_DUMP OFF)
        if(UNIX AND NOT APPLE)
            if(NOT DEFINED HIDAPI_WITH_HIDRAW)
                set(HIDAPI_WITH_HIDRAW ON)
            endif()
            if(NOT DEFINED HIDAPI_WITH_LIBUSB)
                if(HIDAPI_WITH_HIDRAW)
                    set(HIDAPI_WITH_LIBUSB OFF)
                else()
                    set(HIDAPI_WITH_LIBUSB ON)
                endif()
            endif()
        endif()
        FetchContent_Declare(hidapi
            GIT_REPOSITORY https://github.com/libusb/hidapi.git
            GIT_TAG hidapi-0.15.0
            EXCLUDE_FROM_ALL)
        FetchContent_MakeAvailable(hidapi)
    endblock()
    if(NOT TARGET hidapi::hidapi)
        message(FATAL_ERROR "Native input requires a shared HIDAPI implementation")
    endif()
    get_target_property(implementation hidapi::hidapi ALIASED_TARGET)
    if(NOT implementation)
        set(implementation hidapi::hidapi)
    endif()
    get_target_property(imported ${implementation} IMPORTED)
    if(NOT imported)
        set(${owned_result} ON PARENT_SCOPE)
    endif()
endfunction()
