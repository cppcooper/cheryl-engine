foreach(required IN ITEMS SCENARIO_EXECUTABLE SCENARIO_FIXTURES SCENARIO_ASSETS
        SCENARIO_OUTPUT SCENARIO_CASE SCENARIO_BUILD)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing batch witness argument: ${required}")
    endif()
endforeach()
if(NOT EXISTS "${SCENARIO_EXECUTABLE}" OR IS_DIRECTORY "${SCENARIO_EXECUTABLE}")
    message(FATAL_ERROR "Scenario executable is unavailable")
endif()
if(NOT SCENARIO_CASE MATCHES "^(heal|refused|wrong-assertion|authoring)$")
    message(FATAL_ERROR "Unknown fixed scenario case")
endif()

set(expected_exit "0")
set(expected_disposition "passed")
set(expected_fixture "contact-heal-v1")
set(expected_assertions "6")
set(assertion_references "$before.health" "$outcome.status" "$outcome.gain"
    "$exact.gain" "$after.health" "$caster.reserve")
set(assertion_values "12" "Applied" "8" "8" "20" "7")
if(SCENARIO_CASE STREQUAL "refused")
    set(expected_fixture "contact-reserve-v1")
    set(expected_assertions "5")
    set(assertion_references "$before.reserve" "$outcome.status" "$outcome.reason"
        "$target.health" "$caster.reserve")
    set(assertion_values "2" "Refused" "Resources" "12" "2")
elseif(SCENARIO_CASE STREQUAL "wrong-assertion")
    set(expected_exit "1")
    set(expected_disposition "failed")
    set(expected_assertions "1")
elseif(SCENARIO_CASE STREQUAL "authoring")
    set(expected_assertions "12")
    set(assertion_references "$draft.state" "$inspected.id" "$quoted.price" "$later.state"
        "$outcome.status" "$outcome.gain" "$exact.gain" "$target.health" "$caster.reserve"
        "$invalid.state" "$unsupported.state" "$retained.gain")
    set(assertion_values "Accepted" "1" "3" "Accepted" "Applied" "5" "5" "17" "7"
        "Invalid" "Unsupported" "5")
endif()

string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(run_id "${SCENARIO_CASE}-${nonce}")
set(output_root "${SCENARIO_OUTPUT}/${run_id}")
if(EXISTS "${output_root}")
    message(FATAL_ERROR "Fresh output root collision: ${output_root}")
endif()
file(MAKE_DIRECTORY "${output_root}")
execute_process(COMMAND "${SCENARIO_EXECUTABLE}" "${SCENARIO_FIXTURES}"
    "${SCENARIO_ASSETS}" "${output_root}" "${SCENARIO_CASE}.console"
    "${run_id}" "${SCENARIO_BUILD}"
    TIMEOUT 20 RESULT_VARIABLE actual_exit OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
file(WRITE "${output_root}/stdout.txt" "${stdout}")
file(WRITE "${output_root}/stderr.txt" "${stderr}")
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "Batch exit '${actual_exit}', expected '${expected_exit}'; evidence: ${output_root}")
endif()

set(run_root "${output_root}/${run_id}")
foreach(artifact IN ITEMS report.json transcript.txt complete)
    if(NOT EXISTS "${run_root}/${artifact}" OR IS_DIRECTORY "${run_root}/${artifact}")
        message(FATAL_ERROR "Missing final artifact: ${run_root}/${artifact}")
    endif()
endforeach()
file(SIZE "${run_root}/report.json" report_size)
file(SIZE "${run_root}/transcript.txt" transcript_size)
if(report_size GREATER 65536 OR transcript_size GREATER 4194304)
    message(FATAL_ERROR "Scenario evidence exceeds declared capacity")
endif()
file(READ "${run_root}/report.json" report)
function(expect_json expected)
    string(JSON actual GET "${report}" ${ARGN})
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected report ${ARGN}: '${actual}', expected '${expected}'")
    endif()
endfunction()
expect_json("1" schema)
expect_json("ON" final)
expect_json("${expected_disposition}" disposition)
expect_json("${run_id}" run)
expect_json("${SCENARIO_CASE}.console" source)
expect_json("${SCENARIO_BUILD}" build_id)
expect_json("${expected_fixture}" fixture)
expect_json("StrictChannels" context_mode)
expect_json("Gameplay" gameplay_context)
expect_json("PracticeObserver Query-only" diagnostic_context)
expect_json("${expected_assertions}" planned_assertions)
expect_json("${expected_assertions}" attempted_assertions)
expect_json("${expected_assertions}" executed_assertions)
expect_json("0" skipped_assertions)
string(JSON assertion_count LENGTH "${report}" assertions)
if(NOT "${assertion_count}" STREQUAL "${expected_assertions}")
    message(FATAL_ERROR "Wrong assertion evidence count")
endif()
math(EXPR last_assertion "${assertion_count} - 1")
foreach(assertion RANGE 0 ${last_assertion})
    expect_json("ON" assertions ${assertion} executed)
    if(SCENARIO_CASE STREQUAL "wrong-assertion")
        expect_json("OFF" assertions ${assertion} passed)
        expect_json("$outcome.gain" assertions ${assertion} reference)
        expect_json("9" assertions ${assertion} expected value)
        expect_json("8" assertions ${assertion} actual value)
    else()
        expect_json("ON" assertions ${assertion} passed)
        list(GET assertion_references ${assertion} expected_reference)
        list(GET assertion_values ${assertion} expected_value)
        expect_json("${expected_reference}" assertions ${assertion} reference)
        expect_json("${expected_value}" assertions ${assertion} expected value)
        expect_json("${expected_value}" assertions ${assertion} actual value)
    endif()
    string(JSON expected_type GET "${report}" assertions ${assertion} expected type)
    expect_json("${expected_type}" assertions ${assertion} actual type)
endforeach()

file(READ "${run_root}/transcript.txt" transcript)
set(snapshot "snapshot ${report}\n")
string(LENGTH "${transcript}" transcript_length)
string(LENGTH "${snapshot}" snapshot_length)
math(EXPR snapshot_offset "${transcript_length} - ${snapshot_length}")
if(snapshot_offset LESS 0)
    message(FATAL_ERROR "Transcript has no final structured snapshot")
endif()
string(SUBSTRING "${transcript}" ${snapshot_offset} -1 final_snapshot)
if(NOT "${final_snapshot}" STREQUAL "${snapshot}")
    message(FATAL_ERROR "Transcript and final JSON disagree")
endif()
file(STRINGS "${run_root}/complete" marker)
list(LENGTH marker marker_lines)
if(NOT marker_lines EQUAL 5)
    message(FATAL_ERROR "Malformed finalization marker")
endif()
list(GET marker 0 marker_run)
list(GET marker 1 marker_source)
string(JSON source_id GET "${report}" source_id)
if(NOT "${marker_run}" STREQUAL "${run_id}" OR
        NOT "${marker_source}" STREQUAL "${source_id}" OR
        NOT source_id MATCHES "^fnv1a64:[0-9a-f]+$")
    message(FATAL_ERROR "Finalization marker identity mismatch")
endif()
message(STATUS "Verified ${SCENARIO_CASE} process witness; evidence: ${output_root}")
