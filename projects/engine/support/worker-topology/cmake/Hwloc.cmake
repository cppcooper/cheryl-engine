# This file is included only for an explicitly selected provider. Never fetch an SDK.
cheryl_configure_hwloc_options()
set(cheryl_hwloc_target "${CHERYL_HWLOC_TARGET}")
if(cheryl_hwloc_target AND NOT TARGET "${cheryl_hwloc_target}")
    message(FATAL_ERROR "CHERYL_HWLOC_TARGET must name an existing target: ${cheryl_hwloc_target}")
endif()

function(cheryl_select_hwloc_target result)
    foreach(candidate IN ITEMS hwloc::hwloc HWLOC::hwloc unofficial::hwloc::hwloc hwloc)
        if(TARGET "${candidate}")
            set(${result} "${candidate}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${result} "" PARENT_SCOPE)
endfunction()

if(NOT cheryl_hwloc_target)
    cheryl_select_hwloc_target(cheryl_hwloc_target)
endif()
if(NOT cheryl_hwloc_target)
    # Honor the toolchain's target roots rather than finding a host config package.
    block(SCOPE_FOR VARIABLES PROPAGATE cheryl_hwloc_target)
        if(CMAKE_CROSSCOMPILING)
            set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
        endif()
        if(NOT CMAKE_CROSSCOMPILING OR CMAKE_SYSROOT OR CMAKE_FIND_ROOT_PATH)
            find_package(hwloc 2.5...<3.0 CONFIG QUIET)
            cheryl_select_hwloc_target(cheryl_hwloc_target)
            if(NOT cheryl_hwloc_target)
                find_package(HWLOC 2.5...<3.0 CONFIG QUIET)
                cheryl_select_hwloc_target(cheryl_hwloc_target)
            endif()
        endif()
    endblock()
endif()
if(NOT cheryl_hwloc_target)
    if(CMAKE_CROSSCOMPILING AND
            ("$ENV{PKG_CONFIG_LIBDIR}" STREQUAL "" OR "$ENV{PKG_CONFIG_SYSROOT_DIR}" STREQUAL ""))
        message(FATAL_ERROR
            "Cross-compiling worker topology requires a supplied target SDK or target PKG_CONFIG_LIBDIR and PKG_CONFIG_SYSROOT_DIR")
    endif()
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        if(CMAKE_CROSSCOMPILING)
            pkg_check_modules(CHERYL_HWLOC QUIET IMPORTED_TARGET GLOBAL
                NO_CMAKE_PATH NO_CMAKE_ENVIRONMENT_PATH "hwloc>=2.5")
        else()
            pkg_check_modules(CHERYL_HWLOC QUIET IMPORTED_TARGET GLOBAL "hwloc>=2.5")
        endif()
        if(CHERYL_HWLOC_FOUND AND CHERYL_HWLOC_VERSION VERSION_LESS "3.0")
            set(cheryl_hwloc_target PkgConfig::CHERYL_HWLOC)
        endif()
    endif()
endif()
if(NOT cheryl_hwloc_target)
    message(FATAL_ERROR
        "CHERYL_BUILD_WORKER_TOPOLOGY_HWLOC requires hwloc 2.5+ (2.x). Supply CHERYL_HWLOC_TARGET or an installed target SDK")
endif()
