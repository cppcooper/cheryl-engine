if(NOT DEFINED CLI OR NOT DEFINED WORK_ROOT OR NOT DEFINED MODE)
    message(FATAL_ERROR "CLI, WORK_ROOT and MODE are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${WORK_ROOT}/${MODE}-${suffix}")
file(MAKE_DIRECTORY "${work}")

function(invoke step)
    execute_process(COMMAND "${CLI}" ${ARGN}
        WORKING_DIRECTORY "${work}"
        OUTPUT_FILE "${work}/${step}.stdout" ERROR_FILE "${work}/${step}.stderr"
        RESULT_VARIABLE result)
    file(WRITE "${work}/${step}.exit" "${result}\n")
    file(WRITE "${work}/${step}.command" "${CLI};${ARGN}\n")
    if(NOT result STREQUAL "0")
        file(READ "${work}/${step}.stdout" output)
        file(READ "${work}/${step}.stderr" error)
        message(FATAL_ERROR "${step}: exit ${result}\n${output}\n${error}\nFull logs: ${work}")
    endif()
endfunction()

if(MODE STREQUAL "memory")
    invoke(memory memory)
elseif(MODE STREQUAL "round_trip")
    invoke(author author "${work}/garden.map.json")
    file(READ "${work}/garden.map.json" before HEX)
    invoke(fresh-verify verify "${work}/garden.map.json")
    file(READ "${work}/garden.map.json" after HEX)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "fresh verification changed bytes in ${work}")
    endif()
elseif(MODE STREQUAL "preservation")
    invoke(preserve preserve "${work}/predecessor.map.json")
    file(READ "${work}/predecessor.map.json" before HEX)
    invoke(fresh-predecessor verify-predecessor "${work}/predecessor.map.json")
    file(READ "${work}/predecessor.map.json" after HEX)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "predecessor verification changed bytes in ${work}")
    endif()
else()
    message(FATAL_ERROR "unknown MODE: ${MODE}")
endif()
message(STATUS "${MODE}: actual independent process checks passed; full logs: ${work}")
