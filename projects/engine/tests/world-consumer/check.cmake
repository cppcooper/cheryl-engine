if(NOT DEFINED CLI OR NOT DEFINED MODE OR NOT DEFINED WORK_ROOT)
    message(FATAL_ERROR "CLI, MODE and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${WORK_ROOT}/${MODE}-${suffix}")
file(MAKE_DIRECTORY "${work}")
set(child_timeout 25)
if(MODE STREQUAL "variable_documents")
    set(child_timeout 65)
endif()
function(invoke step)
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${work}"
        OUTPUT_FILE "${work}/${step}.stdout" ERROR_FILE "${work}/${step}.stderr"
        RESULT_VARIABLE result TIMEOUT ${child_timeout})
    file(WRITE "${work}/${step}.exit" "${result}\n")
    file(WRITE "${work}/${step}.command" "${CLI};${ARGN}\n")
    if(NOT result STREQUAL "0")
        file(READ "${work}/${step}.stdout" output)
        file(READ "${work}/${step}.stderr" error)
        message(FATAL_ERROR "${step}: ${result}\n${output}\n${error}\nFull logs: ${work}")
    endif()
endfunction()
if(MODE STREQUAL "literal" OR MODE STREQUAL "generated")
    invoke(author "${MODE}-author" "${work}/result.json")
    file(READ "${work}/result.json" before HEX)
    invoke(fresh-verify "${MODE}-verify" "${work}/result.json")
    file(READ "${work}/result.json" after HEX)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Fresh read-only verifier changed published bytes")
    endif()
elseif(MODE STREQUAL "editor_documents")
    invoke(editor-author editor-author "${work}")
    file(READ "${work}/west.json" west_before HEX)
    file(READ "${work}/east.json" east_before HEX)
    invoke(fresh-editor-verify editor-verify "${work}")
    file(READ "${work}/west.json" west_after HEX)
    file(READ "${work}/east.json" east_after HEX)
    if(NOT west_before STREQUAL west_after OR NOT east_before STREQUAL east_after)
        message(FATAL_ERROR "Fresh editor verifier changed document bytes")
    endif()
elseif(MODE STREQUAL "semantic_documents")
    invoke(semantic-author semantic-author "${work}")
    file(READ "${work}/west-terrain.json" west_before HEX)
    file(READ "${work}/east-terrain.json" east_before HEX)
    file(READ "${work}/west.json" literal_before HEX)
    invoke(fresh-semantic-verify semantic-verify "${work}")
    file(READ "${work}/west-terrain.json" west_after HEX)
    file(READ "${work}/east-terrain.json" east_after HEX)
    file(READ "${work}/west.json" literal_after HEX)
    if(NOT west_before STREQUAL west_after OR NOT east_before STREQUAL east_after OR NOT literal_before STREQUAL literal_after)
        message(FATAL_ERROR "Fresh semantic verifier changed published bytes")
    endif()
elseif(MODE STREQUAL "document_history")
    invoke(history-author history-author "${work}")
    foreach(name IN ITEMS west.json east.json west-terrain.json east-terrain.json)
        file(READ "${work}/${name}" "before_${name}" HEX)
    endforeach()
    invoke(fresh-history-verify history-verify "${work}")
    foreach(name IN ITEMS west.json east.json west-terrain.json east-terrain.json)
        file(READ "${work}/${name}" after HEX)
        if(NOT "${before_${name}}" STREQUAL "${after}")
            message(FATAL_ERROR "Fresh history verifier changed ${name} bytes")
        endif()
    endforeach()
elseif(MODE STREQUAL "variable_documents")
    invoke(variable-author variable-author "${work}")
    foreach(domain RANGE 0 4)
        foreach(name IN ITEMS west.json east.json west-terrain.json east-terrain.json)
            file(SHA256 "${work}/domain-${domain}/${name}" "before_${domain}_${name}")
        endforeach()
    endforeach()
    invoke(fresh-variable-verify variable-verify "${work}")
    foreach(domain RANGE 0 4)
        foreach(name IN ITEMS west.json east.json west-terrain.json east-terrain.json)
            file(SHA256 "${work}/domain-${domain}/${name}" after)
            if(NOT "${before_${domain}_${name}}" STREQUAL "${after}")
                message(FATAL_ERROR "Fresh variable verifier changed domain-${domain}/${name}")
            endif()
        endforeach()
    endforeach()
elseif(MODE STREQUAL "refusals")
    invoke(refusals refusals "${work}/predecessor.json")
    file(READ "${work}/predecessor.json" before HEX)
    invoke(fresh-predecessor literal-base-verify "${work}/predecessor.json")
    file(READ "${work}/predecessor.json" after HEX)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "Fresh predecessor verifier changed bytes")
    endif()
else()
    message(FATAL_ERROR "Unknown world scenario: ${MODE}")
endif()
message(STATUS "${MODE}: full owned process evidence in ${work}")
