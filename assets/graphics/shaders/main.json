{
  "$schema": "../../schemas/shader-assets-1.0.schema.json",
  "asset_class": "shader",
  "version": "1.0",
  "namespace": "main",
  "programs": [
    {
      "name": "program-2d",
      "stages": {
        "vertex": "shader2d.vert",
        "fragment": "shader2d.frag"
      }
    }
  ],
  "materials": [
    {
      "name": "text",
      "program": "main:program-2d",
      "vertex_layout": "position3_uv2",
      "topology": "triangles",
      "parameters": [
        {"key": "projection", "type": "mat4", "semantic": "projection"},
        {"key": "view", "type": "mat4", "semantic": "view"},
        {"key": "model", "type": "mat4", "semantic": "model"},
        {"key": "alpha", "type": "float", "semantic": "alpha"},
        {"key": "scale", "type": "float", "semantic": "scale"},
        {"key": "image", "type": "sampler2d"}
      ],
      "bindings": {
        "opengl": {
          "attributes": {"position": "in_Position", "texcoord": "in_Texcoord"},
          "parameters": {
            "projection": "projectionMatrix",
            "view": "viewMatrix",
            "model": "modelMatrix",
            "alpha": "in_Alpha",
            "scale": "in_Scale",
            "image": "mytexture"
          }
        }
      }
    },
    {
      "name": "images",
      "program": "main:program-2d",
      "vertex_layout": "position3_uv2",
      "topology": "triangle_strip",
      "parameters": [
        {"key": "projection", "type": "mat4", "semantic": "projection"},
        {"key": "view", "type": "mat4", "semantic": "view"},
        {"key": "model", "type": "mat4", "semantic": "model"},
        {"key": "alpha", "type": "float", "semantic": "alpha"},
        {"key": "scale", "type": "float", "semantic": "scale"},
        {"key": "image", "type": "sampler2d"}
      ],
      "bindings": {
        "opengl": {
          "attributes": {"position": "in_Position", "texcoord": "in_Texcoord"},
          "parameters": {
            "projection": "projectionMatrix",
            "view": "viewMatrix",
            "model": "modelMatrix",
            "alpha": "in_Alpha",
            "scale": "in_Scale",
            "image": "mytexture"
          }
        }
      }
    }
  ]
}
