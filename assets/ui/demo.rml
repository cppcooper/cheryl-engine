<rml>
<head>
<title>Cheryl RmlUi proof</title>
<style>
    body { width: 100%; height: 100%; margin: 0; font-family: demo; font-size: 16px; color: #edf2fa; }
    #panel {
        position: absolute; left: 24px; top: 24px;
        width: 34%; min-width: 360px; max-width: 600px;
        height: 75%; min-height: 500px; max-height: 800px;
        box-sizing: border-box; padding: 18px;
        display: flex; flex-direction: column;
        background-color: #26394be8; border-width: 1px; border-color: #85b7be;
        overflow: hidden;
    }
    h1 { font-size: 24px; margin: 0 0 10px; flex-shrink: 0; }
    #badge { position: absolute; right: 10px; top: 10px; padding: 5px 10px; background-color: #5f989faa; }
    .instructions { margin-bottom: 10px; flex-shrink: 0; font-size: 14px; }
    #status { height: 46px; flex-shrink: 0; }
    button { display: inline-block; padding: 7px 12px; background-color: #477989; color: #ffffff; }
    button:hover { background-color: #5b92a0; }
    button:active { background-color: #365b6b; }
    #reset { align-self: flex-start; margin: 8px 0 12px; flex-shrink: 0; }
    input { display: block; height: 34px; box-sizing: border-box; padding: 6px;
            background-color: #edf2fa; color: #172532; flex-shrink: 0; }
    input:focus { border-width: 1px; border-color: #89d8ef; }
    #scroll { flex-grow: 1; flex-basis: 0; min-height: 80px; overflow: auto;
              margin: 12px 0; padding: 6px; background-color: #354d65b0; }
    .row { display: block; padding: 7px; margin-bottom: 4px; background-color: #6098b477; }
    scrollbarvertical { width: 12px; }
    scrollbarvertical slidertrack { background-color: #182b3c; }
    scrollbarvertical sliderbar { min-height: 20px; background-color: #73a5b9; }
    scrollbarvertical sliderbar:hover { background-color: #a4d1df; }
    #image-row { display: flex; align-items: center; height: 64px; flex-shrink: 0; padding: 6px; background-color: #715a8860; }
    #image { width: 52px; height: 52px; margin-right: 14px; }
    #edge { position: absolute; left: 18px; bottom: 18px; padding: 5px 10px; background-color: #477989; }
    #tooltip { display: none; position: absolute; bottom: 100%; left: 0;
               width: 260px; padding: 8px; background-color: #182b3cf5; }
    #edge:hover #tooltip { display: block; }
</style>
</head>
<body>
    <div id="panel">
        <h1>Cheryl UI</h1><div id="badge">RmlUi</div>
        <div class="instructions">F4: edit · Esc: release focus · F6: hide/show</div>
        <div id="status"></div>
        <button id="reset">Reset camera</button>
        <input id="field" type="text" value="Click here and type" />
        <div id="scroll">
            <div class="row">Scroll item 1</div><div class="row">Scroll item 2</div>
            <div class="row">Scroll item 3</div><div class="row">Scroll item 4</div>
            <div class="row">Scroll item 5</div><div class="row">Scroll item 6</div>
            <div class="row">Scroll item 7</div><div class="row">Scroll item 8</div>
            <div class="row">Scroll item 9</div><div class="row">Scroll item 10</div>
        </div>
        <div id="image-row"><img id="image" src="quadrants.png" /><button id="change-image">Change image</button></div>
    </div>
    <div id="edge">?<div id="tooltip">This tooltip stays inside the window.</div></div>
</body>
</rml>
